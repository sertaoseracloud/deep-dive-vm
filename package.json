{
  "name": "template-dd",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:visual": "npx playwright test --project=chromium",
    "test:unit": "vitest run --reporter=verbose --coverage",
    "test:integration": "vitest run --reporter=verbose tests/integration",
    "test:unit:watch": "vitest --watch",
    "test:all": "vitest run --coverage",
    "lighthouse": "lighthouse https://mentoria.sertaoseracloud.com/deep-dive-vm/ --output json --output-path lighthouse-report.json --chrome-flags=\"--headless --no-sandbox\"",
    "lighthouse:ci": "npm run build && npx astro preview & sleep 3 && npm run lighthouse",
    "capture:baselines": "node src/scripts/capture-baselines.js"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.1",
    "astro-seo": "^1.1.0",
    "gray-matter": "^4.0.3",
    "motion": "^12.38.0",
    "pixelmatch": "^7.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "unified": "^11.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.9.0",
    "jsdom": "^25.0.1",
    "lighthouse": "^13.3.0",
    "playwright": "^1.59.1",
    "vitest": "^3.2.4"
  }
}

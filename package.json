{
  "name": "template-dd",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:visual": "npx playwright test --project=chromium",
    "test:unit": "vitest run --reporter=verbose --coverage",
    "test:integration": "vitest run --reporter=verbose tests/integration",
    "test:unit:watch": "vitest --watch",
    "test:all": "vitest run --coverage",
    "lighthouse": "lighthouse https://mentoria.sertaoseracloud.com/deep-dive-vm/ --output json --output-path lighthouse-report.json --chrome-flags=\"--headless --no-sandbox\"",
    "lighthouse:ci": "npm run build && npx astro preview & sleep 3 && npm run lighthouse",
    "capture:baselines": "node src/scripts/capture-baselines.js",
    "test:axe": "npx playwright test tests/e2e/motion-accessibility.spec.ts --project=chromium",
    "test:perf": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "astro-seo": "^1.2.0",
    "gray-matter": "^4.0.3",
    "motion": "^12.38.0",
    "pixelmatch": "^7.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^5.0.4",
    "happy-dom": "^20.9.0",
    "impeccable": "^4.5.2",
    "jsdom": "^25.0.1",
    "lighthouse": "^13.5.0",
    "playwright": "^1.59.1",
    "vitest": "^5.0.4"
  }
}

{
  "name": "template-dd",
  "type": "module",
  "version": "1.12.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "test:visual": "npx playwright test --project=chromium",
    "pretest:unit": "npm run build",
    "test:unit": "vitest run --reporter=verbose --coverage",
    "test:unit:watch": "vitest --watch",
    "pretest:all": "npm run build",
    "test:all": "vitest run --coverage",
    "lighthouse": "lighthouse https://mentoria.sertaoseracloud.com/ --output json --output-path lighthouse-report.json --chrome-flags=\"--headless --no-sandbox\"",
    "lighthouse:ci": "npm run build && npm run test:perf",
    "test:axe": "npx playwright test tests/e2e/acessibilidade-telas.spec.ts --project=chromium",
    "test:perf": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.1",
    "astro-seo": "^1.2.0",
    "mermaid": "12.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "impeccable": "4.7.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.64.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "lighthouse": "$lighthouse",
    "puppeteer-core": "^25.13.0",
    "@puppeteer/browsers": "^3.2.4",
    "basic-ftp": "^6.2.3",
    "tmp": "^0.2.7",
    "@lhci/cli": {
      "uuid": "^11.1.1"
    }
  }
}

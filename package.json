{
  "name": "template-dd",
  "type": "module",
  "version": "1.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:visual": "npx playwright test --project=chromium",
    "test:unit": "vitest run --reporter=verbose --coverage",
    "test:unit:watch": "vitest --watch",
    "test:all": "vitest run --coverage",
    "lighthouse": "lighthouse https://mentoria.sertaoseracloud.com/ --output json --output-path lighthouse-report.json --chrome-flags=\"--headless --no-sandbox\"",
    "lighthouse:ci": "npm run build && npx astro preview & sleep 3 && npm run lighthouse",
    "test:axe": "npx playwright test tests/e2e/acessibilidade-telas.spec.ts --project=chromium",
    "test:perf": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "astro-seo": "^1.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@vitest/coverage-v8": "^5.0.4",
    "happy-dom": "^20.9.0",
    "impeccable": "4.5.2",
    "lighthouse": "^13.5.0",
    "playwright": "^1.59.1",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "puppeteer-core": "^25.13.0",
    "@puppeteer/browsers": "^3.2.4",
    "basic-ftp": "^6.2.3",
    "tmp": "^0.2.7"
  }
}

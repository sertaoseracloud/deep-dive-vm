---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import claudio2 from "../assets/claudio2.png";
import { socialLinks } from "../data/social-links";
import { courses } from "../data/courses";
import SocialIcon from "../components/ui/SocialIcon.astro";
import BannerCarousel from "../components/ui/BannerCarousel.astro";
import CourseCard from "../components/hub/CourseCard.astro";
import EventCard from "../components/hub/EventCard.astro";
import PostCard from "../components/hub/PostCard.astro";
import artigos from "../data/devto-artigos.json";
import { PERFIL, idiomas, nomeDoIdioma } from "../lib/devto.js";
import { upcomingEvents } from "../data/events";
import { agruparPorMes, nomeDoMes } from "../lib/eventos";
import "../styles/hub.css";

const courseSlides = courses
  .filter((c) => c.status === "active" && c.banner)
  .map((c) => ({ title: c.title, url: c.url, banner: c.banner! }));
const cursosAtivos = courses.filter((c) => c.status === "active").length;
const eventos = upcomingEvents();
const eventSlides = eventos.flatMap((e) =>
  e.links.filter((l) => l.banner).map((l) => ({ title: `${e.title}: ${l.label}`, url: l.url, banner: l.banner! }))
);

const porMes = agruparPorMes(eventos);
const idiomasDoBlog = idiomas(artigos);
/** Cards visíveis de início na aba Blog; o resto aparece com "Mostrar mais". */
const POR_VEZ = 9;
const ano = new Date().getFullYear();
---

<Layout
  title="Cláudio Rapôso — O Sertão será Cloud"
  description="Cursos gratuitos e acessíveis: DivergePHP, DivergeTerraform, DivergePython e DivergeKubernetes no navegador, além de eventos e blog."
  url="https://mentoria.sertaoseracloud.com/"
  ogImage="/hub-og.png"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Cláudio Filipe Lima Rapôso",
    jobTitle: "Lead Software Architecture & DevRel",
    worksFor: [
      { "@type": "Organization", name: "NTT DATA Europe & Latam" },
      { "@type": "EducationalOrganization", name: "UniSENAI Santa Catarina" },
    ],
    award: ["Microsoft MVP", "Docker Captain", "AWS Golden Jacket"],
    knowsAbout: ["Arquitetura de software", "AWS", "Microsoft Azure", "Kubernetes", "Docker", "Terraform", "DevSecOps", "IA, LLMs e RAG"],
    knowsLanguage: ["pt-BR", "en", "es"],
    url: "https://mentoria.sertaoseracloud.com/",
    sameAs: socialLinks.map((s) => s.url),
  }}
>
  <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo</a>

  <main id="conteudo-principal" tabindex="-1" aria-label="Hub de cursos e eventos">
    <div class="hub-container">

      <header class="hub-profile">
        <Image
          src={claudio2}
          alt="Cláudio Filipe Lima Rapôso"
          width={128}
          height={128}
          class="mentor-photo"
          loading="eager"
        />
        <div class="perfil-texto">
          <h1>Cláudio Filipe Lima Rapôso</h1>
          <p class="bio">Arquiteto de Soluções · Microsoft MVP · Docker Captain · AWS Golden Jacket</p>
          <p class="tagline">
            Lead Software Architecture &amp; DevRel na NTT DATA e professor no UniSENAI SC. Mais de 10 anos em
            arquitetura de software e cloud (AWS e Azure) e mais de 1.000 pessoas mentoradas. Aqui ficam meus
            cursos gratuitos e acessíveis e a agenda de eventos da comunidade.
          </p>
          <div class="perfil-rodape">
            <ul class="atalhos" aria-label="Atalhos">
              <li><a href="#cursos" data-ir-aba="cursos">{cursosAtivos} cursos gratuitos</a></li>
              {eventos.length > 0 && <li><a href="#eventos" data-ir-aba="eventos">{eventos.length} próximos eventos</a></li>}
              {artigos.length > 0 && <li><a href="#blog" data-ir-aba="blog">{artigos.length} artigos no blog</a></li>}
            </ul>
            <ul class="social-links" aria-label="Redes sociais">
              {socialLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    aria-label={`${link.ariaLabel} (abre em nova aba)`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-icon-link"
                  >
                    <SocialIcon name={link.icon} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </header>

      <!-- Abas Cursos | Eventos. Sem JavaScript as duas seções aparecem uma embaixo da outra. -->
      <div class="hub-abas" role="tablist" aria-label="Cursos e eventos" data-abas hidden>
        <button type="button" role="tab" id="aba-cursos" aria-controls="painel-cursos" aria-selected="true" data-aba="cursos">
          Cursos<span class="aba-contador" aria-hidden="true">{cursosAtivos}</span>
        </button>
        <button type="button" role="tab" id="aba-eventos" aria-controls="painel-eventos" aria-selected="false" tabindex="-1" data-aba="eventos">
          Eventos{eventos.length > 0 && <span class="aba-contador" aria-hidden="true" data-contador-eventos>{eventos.length}</span>}
        </button>
        <button type="button" role="tab" id="aba-blog" aria-controls="painel-blog" aria-selected="false" tabindex="-1" data-aba="blog">
          Blog<span class="aba-contador" aria-hidden="true">{artigos.length}</span>
        </button>
      </div>

      <section class="hub-painel" id="painel-cursos" aria-labelledby="titulo-cursos" data-painel="cursos">
        <h2 id="titulo-cursos">Cursos</h2>
        <p class="painel-intro">Do zero ao certificado, direto no navegador: sem instalar nada, sem cadastro e com recursos para pessoas cegas, surdas e neurodivergentes.</p>
        <BannerCarousel label="Banners dos cursos" slides={courseSlides} />
        <div class="course-list">
          {courses.map((course) => (
            <CourseCard course={course} />
          ))}
        </div>
      </section>

      <section class="hub-painel" id="painel-eventos" aria-labelledby="titulo-eventos" data-painel="eventos">
        <h2 id="titulo-eventos">Eventos</h2>
        {eventos.length === 0 ? (
          <p class="painel-intro">Nenhum evento agendado no momento. Volte em breve!</p>
        ) : (
          <>
            <p class="painel-intro">Eventos da comunidade em que participo ou que recomendo, com links oficiais de inscrição e de call for papers. As edições regionais da MVP Conference são gratuitas.</p>
            <BannerCarousel label="Banners dos eventos" slides={eventSlides} />
            {porMes.map(([chave, lista]) => (
              <section class="mes" aria-labelledby={`mes-${chave}`} data-mes>
                <h3 class="mes-titulo" id={`mes-${chave}`}>{nomeDoMes(chave)}</h3>
                <div class="course-list">
                  {lista.map((evento) => (
                    <EventCard evento={evento} />
                  ))}
                </div>
              </section>
            ))}
          </>
        )}
      </section>

      <section class="hub-painel" id="painel-blog" aria-labelledby="titulo-blog" data-painel="blog" data-por-vez={POR_VEZ}>
        <h2 id="titulo-blog">Blog</h2>
        <p class="painel-intro">
          Artigos sobre arquitetura, cloud (AWS e Azure), Terraform, Kubernetes e IA, publicados no{" "}
          <a href={PERFIL} target="_blank" rel="noopener noreferrer">dev.to/sertaoseracloud<span class="sr-only"> (abre em nova aba)</span></a>.
          A lista é atualizada todo dia à meia-noite.
        </p>
        {idiomasDoBlog.length > 1 && (
          <div class="blog-filtro" role="group" aria-label="Filtrar artigos por idioma" data-filtro-blog hidden>
            <button type="button" aria-pressed="true" data-idioma="">Todos <span aria-hidden="true">({artigos.length})</span></button>
            {idiomasDoBlog.map((codigo) => (
              <button type="button" aria-pressed="false" data-idioma={codigo}>
                {nomeDoIdioma(codigo)} <span aria-hidden="true">({artigos.filter((a) => a.language === codigo).length})</span>
              </button>
            ))}
          </div>
        )}
        <div class="course-list post-list" data-lista-blog>
          {artigos.map((artigo) => <PostCard artigo={artigo} />)}
        </div>
        <p class="blog-rodape">
          <button type="button" class="course-star" data-mais-blog hidden>Mostrar mais artigos</button>
          <span class="sr-only" aria-live="polite" data-anuncio-blog></span>
          <a href={PERFIL} class="link-texto" target="_blank" rel="noopener noreferrer">Ver todos no dev.to<span aria-hidden="true"> ↗</span><span class="sr-only"> (abre em nova aba)</span></a>
        </p>
      </section>

    </div>
  </main>

  <footer class="hub-footer">
    <nav aria-label="Rodapé">
      <ul>
        <li><a href="/acessibilidade/">Declaração de acessibilidade</a></li>
        <li><a href="https://github.com/sertaoseracloud" target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (abre em nova aba)</span></a></li>
      </ul>
    </nav>
    <p>© {ano} O Sertão será Cloud · Feito com acessibilidade para todas as pessoas.</p>
  </footer>
</Layout>

<script>
  import { encerrado, hojeIso, textoFaltam } from "../lib/eventos";

  // Abas acessíveis (padrão WAI-ARIA): setas, Home e End trocam a aba; o
  // endereço #eventos abre direto em Eventos.
  const lista = document.querySelector<HTMLElement>("[data-abas]");
  if (lista) {
    const abas = [...lista.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paineis = abas.map((a) => document.getElementById(a.getAttribute("aria-controls")!)!);
    lista.hidden = false;
    paineis.forEach((p, i) => {
      p.setAttribute("role", "tabpanel");
      p.setAttribute("tabindex", "0");
      p.setAttribute("aria-labelledby", abas[i].id);
      p.querySelector("h2")?.classList.add("sr-only");
    });

    const selecionar = (i: number) => {
      abas.forEach((a, j) => {
        a.setAttribute("aria-selected", String(i === j));
        a.tabIndex = i === j ? 0 : -1;
        paineis[j].hidden = i !== j;
      });
    };

    abas.forEach((a, i) => {
      a.addEventListener("click", () => {
        selecionar(i);
        history.replaceState(null, "", i === 0 ? location.pathname : `#${a.dataset.aba}`);
      });
    });
    lista.addEventListener("keydown", (e) => {
      const atual = abas.findIndex((a) => a.getAttribute("aria-selected") === "true");
      const destino =
        e.key === "ArrowRight" ? (atual + 1) % abas.length
        : e.key === "ArrowLeft" ? (atual - 1 + abas.length) % abas.length
        : e.key === "Home" ? 0
        : e.key === "End" ? abas.length - 1
        : -1;
      if (destino < 0) return;
      e.preventDefault();
      abas[destino].click();
      abas[destino].focus();
    });

    // Atalhos do perfil: abrem a aba e levam o foco até ela.
    document.querySelectorAll<HTMLAnchorElement>("[data-ir-aba]").forEach((link) => {
      link.addEventListener("click", (e) => {
        const i = abas.findIndex((a) => a.dataset.aba === link.dataset.irAba);
        if (i < 0) return;
        e.preventDefault();
        abas[i].click();
        abas[i].focus();
        lista.scrollIntoView({ block: "start" });
      });
    });

    const daUrl = () => Math.max(0, abas.findIndex((a) => `#${a.dataset.aba}` === location.hash));
    selecionar(daUrl());
    window.addEventListener("hashchange", () => selecionar(daUrl()));
  }

  // Eventos: "faltam 12 dias", "é amanhã", "acontece hoje". Os que já acabaram
  // somem mesmo antes da próxima publicação do site (a lista é montada no build).
  const hoje = hojeIso();
  document.querySelectorAll<HTMLElement>(".event-card").forEach((card) => {
    if (encerrado(card.dataset.fim!, hoje)) {
      card.remove();
      return;
    }
    const texto = textoFaltam(card.dataset.inicio!, hoje);
    const alvo = card.querySelector<HTMLElement>("[data-faltam]");
    if (alvo && texto) alvo.textContent = ` · ${texto}`;
  });
  document.querySelectorAll<HTMLElement>("[data-mes]").forEach((mes) => {
    if (!mes.querySelector(".event-card")) mes.remove();
  });
  const contador = document.querySelector<HTMLElement>("[data-contador-eventos]");
  if (contador) contador.textContent = String(document.querySelectorAll(".event-card").length);

  // Blog: filtro por idioma e "Mostrar mais" (sem JavaScript, todos os cards aparecem).
  const listaBlog = document.querySelector<HTMLElement>("[data-lista-blog]");
  if (listaBlog) {
    const POR_VEZ = Number(listaBlog.closest<HTMLElement>("[data-painel]")?.dataset.porVez ?? 9);
    const cards = [...listaBlog.querySelectorAll<HTMLElement>(".post-card")];
    const filtro = document.querySelector<HTMLElement>("[data-filtro-blog]");
    const mais = document.querySelector<HTMLButtonElement>("[data-mais-blog]")!;
    const anuncio = document.querySelector<HTMLElement>("[data-anuncio-blog]")!;
    let idioma = "";
    let limite = POR_VEZ;

    const mostrar = () => {
      const doIdioma = cards.filter((c) => !idioma || c.dataset.idioma === idioma);
      cards.forEach((c) => (c.hidden = true));
      doIdioma.slice(0, limite).forEach((c) => (c.hidden = false));
      const restantes = doIdioma.length - limite;
      mais.hidden = restantes <= 0;
      mais.textContent = `Mostrar mais artigos (${Math.max(restantes, 0)})`;
      return doIdioma;
    };

    filtro?.removeAttribute("hidden");
    filtro?.querySelectorAll<HTMLButtonElement>("[data-idioma]").forEach((botao) => {
      botao.addEventListener("click", () => {
        filtro!.querySelectorAll("[data-idioma]").forEach((b) => b.setAttribute("aria-pressed", String(b === botao)));
        idioma = botao.dataset.idioma ?? "";
        limite = POR_VEZ;
        const total = mostrar().length;
        anuncio.textContent = `${total} ${total === 1 ? "artigo" : "artigos"}.`;
      });
    });

    mais.addEventListener("click", () => {
      const primeiroNovo = limite;
      limite += POR_VEZ;
      const lista = mostrar();
      // Leva o foco ao primeiro card novo, para quem usa teclado ou leitor de tela.
      lista[primeiroNovo]?.querySelector<HTMLAnchorElement>("a")?.focus();
      anuncio.textContent = `Mostrando ${Math.min(limite, lista.length)} de ${lista.length} artigos.`;
    });
    mostrar();
  }
</script>

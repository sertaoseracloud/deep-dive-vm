---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import claudio2 from "../assets/claudio2.png";
import { socialLinks } from "../data/social-links";
import { courses } from "../data/courses";
import SocialIcon from "../components/ui/SocialIcon.astro";
import BannerCarousel from "../components/ui/BannerCarousel.astro";
import { upcomingEvents, type Event } from "../data/events";

const courseSlides = courses
  .filter((c) => c.status === "active" && c.banner)
  .map((c) => ({ title: c.title, url: c.url, banner: c.banner! }));
const cursosAtivos = courses.filter((c) => c.status === "active").length;
const eventos = upcomingEvents();
const eventSlides = eventos.flatMap((e) =>
  e.links.filter((l) => l.banner).map((l) => ({ title: `${e.title}: ${l.label}`, url: l.url, banner: l.banner! }))
);

// Eventos agrupados por mês ("novembro de 2026"), na ordem de upcomingEvents().
const MESES = ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"];
const MESES_CURTOS = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
const porMes = new Map<string, Event[]>();
for (const e of eventos) {
  const chave = e.dates[0].slice(0, 7);
  porMes.set(chave, [...(porMes.get(chave) ?? []), e]);
}
const nomeDoMes = (chave: string) => `${MESES[Number(chave.slice(5, 7)) - 1]} de ${chave.slice(0, 4)}`;
const dia = (data: string) => Number(data.slice(8, 10));
const mesCurto = (data: string) => MESES_CURTOS[Number(data.slice(5, 7)) - 1];
const temCfp = (e: Event) => e.links.some((l) => l.label === "Call for papers");
const textoDoBotao = (label: string) => (label === "Call for papers" ? "Enviar palestra" : "Inscrever-se");
const preposicao = (label: string) => (label === "Call for papers" ? "para a" : "na");
const ano = new Date().getFullYear();
---

<Layout
  title="Cláudio Rapôso — O Sertão será Cloud"
  description="Cursos gratuitos e acessíveis no navegador (DivergePHP, DivergeTerraform e DivergePython), eventos da comunidade e redes do mentor."
  url="https://mentoria.sertaoseracloud.com/"
  ogImage="/hub-og.png"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Cláudio Filipe Lima Rapôso",
    jobTitle: "Lead Software Architecture & DevRel",
    worksFor: [
      { "@type": "Organization", name: "NTT DATA Europe & Latam" },
      { "@type": "EducationalOrganization", name: "UniSENAI Santa Catarina" },
    ],
    award: ["Microsoft MVP", "Docker Captain", "AWS Golden Jacket"],
    knowsAbout: ["Arquitetura de software", "AWS", "Microsoft Azure", "Kubernetes", "Docker", "Terraform", "DevSecOps", "IA, LLMs e RAG"],
    knowsLanguage: ["pt-BR", "en", "es"],
    url: "https://mentoria.sertaoseracloud.com/",
    sameAs: socialLinks.map((s) => s.url),
  }}
>
  <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo</a>

  <main id="conteudo-principal" tabindex="-1" aria-label="Hub de cursos e eventos">
    <div class="hub-container">

      <header class="hub-profile">
        <Image
          src={claudio2}
          alt="Cláudio Filipe Lima Rapôso"
          width={128}
          height={128}
          class="mentor-photo"
          loading="eager"
        />
        <div class="perfil-texto">
          <h1>Cláudio Filipe Lima Rapôso</h1>
          <p class="bio">Arquiteto de Soluções · Microsoft MVP · Docker Captain · AWS Golden Jacket</p>
          <p class="tagline">
            Lead Software Architecture &amp; DevRel na NTT DATA e professor no UniSENAI SC. Mais de 10 anos em
            arquitetura de software e cloud (AWS e Azure) e mais de 1.000 pessoas mentoradas. Aqui ficam meus
            cursos gratuitos e acessíveis e a agenda de eventos da comunidade.
          </p>
          <div class="perfil-rodape">
            <ul class="atalhos" aria-label="Atalhos">
              <li><a href="#cursos" data-ir-aba="cursos">{cursosAtivos} cursos gratuitos</a></li>
              {eventos.length > 0 && <li><a href="#eventos" data-ir-aba="eventos">{eventos.length} próximos eventos</a></li>}
            </ul>
            <ul class="social-links" aria-label="Redes sociais">
              {socialLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    aria-label={`${link.ariaLabel} (abre em nova aba)`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-icon-link"
                  >
                    <SocialIcon name={link.icon} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </header>

      <!-- Abas Cursos | Eventos. Sem JavaScript as duas seções aparecem uma embaixo da outra. -->
      <div class="hub-abas" role="tablist" aria-label="Cursos e eventos" data-abas hidden>
        <button type="button" role="tab" id="aba-cursos" aria-controls="painel-cursos" aria-selected="true" data-aba="cursos">
          Cursos<span class="aba-contador" aria-hidden="true">{cursosAtivos}</span>
        </button>
        <button type="button" role="tab" id="aba-eventos" aria-controls="painel-eventos" aria-selected="false" tabindex="-1" data-aba="eventos">
          Eventos{eventos.length > 0 && <span class="aba-contador" aria-hidden="true" data-contador-eventos>{eventos.length}</span>}
        </button>
      </div>

      <section class="hub-painel" id="painel-cursos" aria-labelledby="titulo-cursos" data-painel="cursos">
        <h2 id="titulo-cursos">Cursos</h2>
        <p class="painel-intro">Do zero ao certificado, direto no navegador: sem instalar nada, sem cadastro e com recursos para pessoas cegas, surdas e neurodivergentes.</p>
        <BannerCarousel label="Banners dos cursos" slides={courseSlides} />
        <div class="course-list">
          {courses.map((course) => (
            <div class={`course-card ${course.status}`} data-status={course.status}>
              <div class="course-header">
                <h3 class="course-title">{course.title}</h3>
                {course.status === "coming-soon" && <span class="badge badge-coming-soon">EM BREVE</span>}
              </div>
              <ul class="chips" aria-label="Destaques">
                {course.exercises && <li class="chip chip-forte">{course.exercises} exercícios</li>}
                <li class="chip">Grátis</li>
                <li class="chip">Certificado</li>
              </ul>
              <p class="course-description">{course.description}</p>
              {course.status === "active" && (
                <div class="course-actions">
                  {course.external ? (
                    <a href={course.url} class="course-link" target="_blank" rel="noopener noreferrer">
                      Acessar curso<span aria-hidden="true"> →</span><span class="sr-only"> {course.title} (abre em nova aba)</span>
                    </a>
                  ) : (
                    <a href={course.url} class="course-link">
                      Acessar curso<span aria-hidden="true"> →</span><span class="sr-only"> {course.title}</span>
                    </a>
                  )}
                  {course.repo && (
                    <a href={course.repo} class="link-texto" target="_blank" rel="noopener noreferrer">
                      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
                      </svg>
                      Dar uma star no GitHub<span class="sr-only"> para o {course.title} (abre em nova aba)</span>
                    </a>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <section class="hub-painel" id="painel-eventos" aria-labelledby="titulo-eventos" data-painel="eventos">
        <h2 id="titulo-eventos">Eventos</h2>
        {eventos.length === 0 ? (
          <p class="painel-intro">Nenhum evento agendado no momento. Volte em breve!</p>
        ) : (
          <>
            <p class="painel-intro">Agenda da MVP Conference, com links oficiais de inscrição e de call for papers. Todas as edições regionais são gratuitas.</p>
            <BannerCarousel label="Banners dos eventos" slides={eventSlides} />
            {[...porMes].map(([chave, lista]) => (
              <section class="mes" aria-labelledby={`mes-${chave}`} data-mes>
                <h3 class="mes-titulo" id={`mes-${chave}`}>{nomeDoMes(chave)}</h3>
                <div class="course-list">
                  {lista.map((evento) => (
                    <article class="course-card active event-card" aria-labelledby={evento.id} data-inicio={evento.dates[0]} data-fim={evento.dates.at(-1)}>
                      <div class="event-topo">
                        <p class="event-data" aria-hidden="true">
                          <span class="event-dia">{dia(evento.dates[0])}{evento.dates.length > 1 && `–${dia(evento.dates.at(-1)!)}`}</span>
                          <span class="event-mes">{mesCurto(evento.dates[0])}</span>
                        </p>
                        <div>
                          <h4 class="course-title" id={evento.id}>{evento.title}</h4>
                          <p class="event-quando">
                            <time datetime={evento.dates[0]}>{evento.when}</time>
                            <span class="event-faltam" data-faltam></span>
                          </p>
                        </div>
                      </div>
                      <ul class="chips" aria-label="Destaques">
                        <li class="chip">{evento.format}</li>
                        {evento.free ? <li class="chip chip-forte">Gratuito</li> : <li class="chip">Renda para ONGs</li>}
                        {temCfp(evento) && <li class="chip chip-alerta">Call for papers aberto</li>}
                      </ul>
                      <p class="event-onde"><span class="sr-only">Local: </span>{evento.where}</p>
                      <p class="course-description">{evento.description}</p>
                      <div class="course-actions">
                        {evento.links.map((link, i) => (
                          <a href={link.url} class={i === 0 ? "course-link" : "course-star"} target="_blank" rel="noopener noreferrer">
                            {textoDoBotao(link.label)}<span aria-hidden="true"> →</span><span class="sr-only"> {preposicao(link.label)} {evento.title} (abre em nova aba)</span>
                          </a>
                        ))}
                        <a href={evento.site} class="link-texto" target="_blank" rel="noopener noreferrer">
                          Site do evento<span aria-hidden="true"> ↗</span><span class="sr-only"> {evento.title} (abre em nova aba)</span>
                        </a>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </>
        )}
      </section>

    </div>
  </main>

  <footer class="hub-footer">
    <nav aria-label="Rodapé">
      <ul>
        <li><a href="/acessibilidade/">Declaração de acessibilidade</a></li>
        <li><a href="https://github.com/sertaoseracloud" target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (abre em nova aba)</span></a></li>
      </ul>
    </nav>
    <p>© {ano} O Sertão será Cloud · Feito com acessibilidade para todas as pessoas.</p>
  </footer>
</Layout>

<script>
  // Abas acessíveis (padrão WAI-ARIA): setas, Home e End trocam a aba; o
  // endereço #eventos abre direto em Eventos.
  const lista = document.querySelector<HTMLElement>("[data-abas]");
  if (lista) {
    const abas = [...lista.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paineis = abas.map((a) => document.getElementById(a.getAttribute("aria-controls")!)!);
    lista.hidden = false;
    paineis.forEach((p, i) => {
      p.setAttribute("role", "tabpanel");
      p.setAttribute("tabindex", "0");
      p.setAttribute("aria-labelledby", abas[i].id);
      p.querySelector("h2")?.classList.add("sr-only");
    });

    const selecionar = (i: number) => {
      abas.forEach((a, j) => {
        a.setAttribute("aria-selected", String(i === j));
        a.tabIndex = i === j ? 0 : -1;
        paineis[j].hidden = i !== j;
      });
    };

    abas.forEach((a, i) => {
      a.addEventListener("click", () => {
        selecionar(i);
        history.replaceState(null, "", i === 0 ? location.pathname : `#${a.dataset.aba}`);
      });
    });
    lista.addEventListener("keydown", (e) => {
      const atual = abas.findIndex((a) => a.getAttribute("aria-selected") === "true");
      const destino =
        e.key === "ArrowRight" ? (atual + 1) % abas.length
        : e.key === "ArrowLeft" ? (atual - 1 + abas.length) % abas.length
        : e.key === "Home" ? 0
        : e.key === "End" ? abas.length - 1
        : -1;
      if (destino < 0) return;
      e.preventDefault();
      abas[destino].click();
      abas[destino].focus();
    });

    // Atalhos do perfil ("3 cursos gratuitos", "6 próximos eventos"): abrem a aba e levam o foco até ela.
    document.querySelectorAll<HTMLAnchorElement>("[data-ir-aba]").forEach((link) => {
      link.addEventListener("click", (e) => {
        const i = abas.findIndex((a) => a.dataset.aba === link.dataset.irAba);
        if (i < 0) return;
        e.preventDefault();
        abas[i].click();
        abas[i].focus();
        lista.scrollIntoView({ block: "start" });
      });
    });

    const daUrl = () => Math.max(0, abas.findIndex((a) => `#${a.dataset.aba}` === location.hash));
    selecionar(daUrl());
    window.addEventListener("hashchange", () => selecionar(daUrl()));
  }

  // Eventos: "em 12 dias", "amanhã", "é hoje". Os que já acabaram somem mesmo
  // antes da próxima publicação do site (a lista é montada no build).
  const hoje = new Date();
  const hojeIso = `${hoje.getFullYear()}-${String(hoje.getMonth() + 1).padStart(2, "0")}-${String(hoje.getDate()).padStart(2, "0")}`;
  const dias = (iso: string) => Math.round((Date.parse(`${iso}T00:00:00`) - Date.parse(`${hojeIso}T00:00:00`)) / 86_400_000);
  document.querySelectorAll<HTMLElement>(".event-card").forEach((card) => {
    const inicio = card.dataset.inicio!;
    const fim = card.dataset.fim!;
    if (fim < hojeIso) {
      card.remove();
      return;
    }
    const faltam = dias(inicio);
    const texto =
      inicio <= hojeIso ? "acontece hoje"
      : faltam === 1 ? "é amanhã"
      : faltam <= 60 ? `faltam ${faltam} dias`
      : "";
    const alvo = card.querySelector<HTMLElement>("[data-faltam]");
    if (alvo && texto) alvo.textContent = ` · ${texto}`;
  });
  document.querySelectorAll<HTMLElement>("[data-mes]").forEach((mes) => {
    if (!mes.querySelector(".event-card")) mes.remove();
  });
  const contador = document.querySelector<HTMLElement>("[data-contador-eventos]");
  if (contador) contador.textContent = String(document.querySelectorAll(".event-card").length);
</script>

<style>
  .hub-container {
    max-width: 992px;
    margin: 0 auto;
    padding: 48px 32px 32px;
    position: relative;
    z-index: 1;
  }

  /* ── Perfil: em coluna no celular, em linha a partir de 720 px ── */
  .hub-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    margin-bottom: 32px;
  }

  .perfil-texto {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .mentor-photo {
    flex: none;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    border: 2px solid var(--nucleo-eletrico);
    box-shadow: 0 0 16px rgb(var(--rgb-ciano) / 0.3);
    object-fit: cover;
  }

  h1 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--texto-principal);
    margin: 0;
  }

  .bio {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--nucleo-eletrico);
    margin: 0;
  }

  .tagline {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--texto-secundario);
    margin: 0;
    max-width: 62ch;
  }

  .perfil-rodape {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 16px;
    margin-top: 4px;
  }

  .atalhos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .atalhos a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: rgb(var(--rgb-cartao) / 0.6);
    color: var(--texto-principal);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .atalhos a:hover {
    border-color: var(--nucleo-eletrico);
    color: var(--nucleo-eletrico);
  }

  @media (min-width: 720px) {
    .hub-profile {
      flex-direction: row;
      align-items: center;
      gap: 32px;
      text-align: left;
    }

    .mentor-photo {
      width: 144px;
      height: 144px;
    }

    h1 {
      font-size: 2.25rem;
    }

    .perfil-rodape,
    .atalhos {
      justify-content: flex-start;
    }
  }

  /* ── Redes sociais ── */
  .social-links {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--texto-terciario);
    text-decoration: none;
    transition: color 0.2s ease, filter 0.2s ease;
    border-radius: 4px;
  }

  .social-icon-link:hover {
    color: var(--nucleo-eletrico);
    filter: drop-shadow(0 0 6px rgb(var(--rgb-ciano) / 0.6));
  }

  /* ── Abas ── */
  .hub-abas {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    border-bottom: 1px solid var(--hairline-strong);
    margin-bottom: 24px;
    scroll-margin-top: 16px;
  }

  .hub-abas[hidden] {
    display: none;
  }

  .hub-abas [role="tab"] {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 16px;
    border: 0;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    background: none;
    color: var(--texto-secundario);
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    cursor: pointer;
  }

  .hub-abas [role="tab"]:hover {
    color: var(--texto-principal);
  }

  .hub-abas [role="tab"][aria-selected="true"] {
    color: var(--texto-principal);
    border-bottom-color: var(--nucleo-eletrico);
  }

  .aba-contador {
    min-width: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: rgb(var(--rgb-texto) / 0.16);
    color: var(--texto-principal);
    font-size: 0.75rem;
    line-height: 22px;
    text-align: center;
  }

  [aria-selected="true"] .aba-contador {
    background: var(--chama-primaria);
    color: #ffffff;
  }

  /* ── Painéis ── */
  .hub-painel {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hub-painel + .hub-painel {
    margin-top: 48px;
  }

  .hub-painel[hidden] {
    display: none;
  }

  .hub-painel:focus-visible {
    outline-offset: 8px;
  }

  .hub-painel h2 {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--texto-principal);
    margin: 0;
  }

  .painel-intro {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--texto-secundario);
    margin: 0;
    max-width: 70ch;
  }

  .mes {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Eventos têm mais texto (data, local, três ações): duas colunas no máximo. */
  .mes .course-list {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
  }

  .mes-titulo {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-terciario);
    margin: 8px 0 0;
  }

  /* ── Cards ── */
  .course-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 24px;
  }

  .course-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: rgb(var(--rgb-cartao) / 0.6);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 24px;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .course-card.active:hover {
    border-color: var(--hairline-strong);
    background: rgb(var(--rgb-cartao) / 0.85);
    transform: translateY(-2px);
  }

  .course-card.coming-soon {
    opacity: 0.7;
    cursor: default;
  }

  .course-card.coming-soon .course-link {
    pointer-events: none;
  }

  .course-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .course-title {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--texto-principal);
    margin: 0;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: 2px 8px;
    border-radius: 2px;
    white-space: nowrap;

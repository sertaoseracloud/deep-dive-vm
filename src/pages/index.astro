---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import claudio2 from "../assets/claudio2.png";
import { socialLinks } from "../data/social-links";
import { courses } from "../data/courses";
import SocialIcon from "../components/ui/SocialIcon.astro";
import BannerCarousel from "../components/ui/BannerCarousel.astro";
import { upcomingEvents } from "../data/events";

const courseSlides = courses
  .filter((c) => c.status === "active" && c.banner)
  .map((c) => ({ title: c.title, url: c.url, banner: c.banner! }));
const eventos = upcomingEvents();
const eventSlides = eventos.flatMap((e) =>
  e.links.filter((l) => l.banner).map((l) => ({ title: `${e.title}: ${l.label}`, url: l.url, banner: l.banner! }))
);
---

<Layout
  title="Cláudio Rapôso — O Sertão será Cloud"
  description="Cursos gratuitos e acessíveis no navegador (DivergePHP, DivergeTerraform e DivergePython), eventos da comunidade e redes do mentor."
  url="https://mentoria.sertaoseracloud.com/"
  ogImage="/hub-og.png"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Cláudio Filipe Lima Rapôso",
    jobTitle: "Systems Architect",
    url: "https://mentoria.sertaoseracloud.com/",
    sameAs: socialLinks.map((s) => s.url),
  }}
>
  <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo</a>

  <main id="conteudo-principal" tabindex="-1" aria-label="Hub de cursos e redes sociais">
    <div class="hub-container">

      <section class="hub-profile" aria-label="Perfil do mentor">
        <Image
          src={claudio2}
          alt="Cláudio Filipe Lima Raposo — mentor"
          width={128}
          height={128}
          class="mentor-photo"
          loading="eager"
        />
        <h1>Cláudio Filipe Lima Raposo</h1>
        <p class="bio">Systems Architect · 2× MVP Microsoft · Docker Captain</p>

        <ul class="social-links" aria-label="Redes sociais">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.url}
                aria-label={`${link.ariaLabel} (abre em nova aba)`}
                target="_blank"
                rel="noopener noreferrer"
                class="social-icon-link"
              >
                <SocialIcon name={link.icon} />
              </a>
            </li>
          ))}
        </ul>
      </section>

      <hr class="hub-divider" aria-hidden="true" />

      <!-- Abas Cursos | Eventos. Sem JavaScript as duas seções aparecem uma embaixo da outra. -->
      <div class="hub-abas" role="tablist" aria-label="Cursos e eventos" data-abas hidden>
        <button type="button" role="tab" id="aba-cursos" aria-controls="painel-cursos" aria-selected="true" data-aba="cursos">Cursos</button>
        <button type="button" role="tab" id="aba-eventos" aria-controls="painel-eventos" aria-selected="false" tabindex="-1" data-aba="eventos">
          Eventos{eventos.length > 0 && <span class="aba-contador" aria-hidden="true">{eventos.length}</span>}
        </button>
      </div>

      <section class="hub-courses hub-painel" id="painel-cursos" aria-labelledby="titulo-cursos" data-painel="cursos">
        <h2 id="titulo-cursos">Cursos</h2>
        <BannerCarousel label="Banners dos cursos" slides={courseSlides} />
        <div class="course-list">
          {courses.map((course) => (
            <div class={`course-card ${course.status}`} data-status={course.status}>
              <div class="course-header">
                <h3 class="course-title">{course.title}</h3>
                <span class={`badge badge-${course.status}`}>
                  {course.status === 'active' ? 'ATIVO' : 'EM BREVE'}
                </span>
              </div>
              <p class="course-description">{course.description}</p>
              {course.status === 'active' && (
                <div class="course-actions">
                  {course.external ? (
                    <a href={course.url} class="course-link" target="_blank" rel="noopener noreferrer">
                      Acessar curso<span aria-hidden="true"> →</span><span class="sr-only"> {course.title} (abre em nova aba)</span>
                    </a>
                  ) : (
                    <a href={course.url} class="course-link">
                      Acessar curso<span aria-hidden="true"> →</span><span class="sr-only"> {course.title}</span>
                    </a>
                  )}
                  {course.repo && (
                    <a href={course.repo} class="course-star" target="_blank" rel="noopener noreferrer">
                      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
                      </svg>
                      Dar uma star no GitHub<span class="sr-only"> para o {course.title} (abre em nova aba)</span>
                    </a>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <section class="hub-courses hub-painel" id="painel-eventos" aria-labelledby="titulo-eventos" data-painel="eventos">
        <h2 id="titulo-eventos">Eventos</h2>
        {eventos.length === 0 ? (
          <p class="course-description">Nenhum evento agendado no momento. Volte em breve!</p>
        ) : (
          <>
            <BannerCarousel label="Banners dos eventos" slides={eventSlides} />
            <div class="course-list">
              {eventos.map((evento) => (
                <article class="course-card active event-card" aria-labelledby={evento.id}>
                  <div class="course-header">
                    <h3 class="course-title" id={evento.id}>{evento.title}</h3>
                    <span class="badge badge-active">{evento.format.toUpperCase()}</span>
                  </div>
                  <dl class="event-meta">
                    <div><dt>Quando</dt><dd><time datetime={evento.dates[0]}>{evento.when}</time></dd></div>
                    <div><dt>Onde</dt><dd>{evento.where}</dd></div>
                  </dl>
                  <p class="course-description">{evento.description}</p>
                  <div class="course-actions">
                    {evento.links.map((link, i) => (
                      <a href={link.url} class={i === 0 ? "course-link" : "course-star"} target="_blank" rel="noopener noreferrer">
                        {link.label}<span aria-hidden="true"> →</span><span class="sr-only"> da {evento.title} (abre em nova aba)</span>
                      </a>
                    ))}
                    <a href={evento.site} class="course-star" target="_blank" rel="noopener noreferrer">
                      Site do evento<span class="sr-only"> {evento.title} (abre em nova aba)</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </>
        )}
      </section>

    </div>
  </main>

  <footer class="hub-footer">
    <a href="/acessibilidade/">Acessibilidade</a>
  </footer>
</Layout>

<script>
  // Abas acessíveis (padrão WAI-ARIA): setas, Home e End trocam a aba; o
  // endereço #eventos abre direto em Eventos.
  const lista = document.querySelector<HTMLElement>("[data-abas]");
  if (lista) {
    const abas = [...lista.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paineis = abas.map((a) => document.getElementById(a.getAttribute("aria-controls")!)!);
    lista.hidden = false;
    paineis.forEach((p, i) => {
      p.setAttribute("role", "tabpanel");
      p.setAttribute("tabindex", "0");
      p.setAttribute("aria-labelledby", abas[i].id);
      p.querySelector("h2")?.classList.add("sr-only");
    });

    const selecionar = (i: number) => {
      abas.forEach((a, j) => {
        a.setAttribute("aria-selected", String(i === j));
        a.tabIndex = i === j ? 0 : -1;
        paineis[j].hidden = i !== j;
      });
    };

    abas.forEach((a, i) => {
      a.addEventListener("click", () => {
        selecionar(i);
        history.replaceState(null, "", i === 0 ? location.pathname : `#${a.dataset.aba}`);
      });
    });
    lista.addEventListener("keydown", (e) => {
      const atual = abas.findIndex((a) => a.getAttribute("aria-selected") === "true");
      const destino =
        e.key === "ArrowRight" ? (atual + 1) % abas.length
        : e.key === "ArrowLeft" ? (atual - 1 + abas.length) % abas.length
        : e.key === "Home" ? 0
        : e.key === "End" ? abas.length - 1
        : -1;
      if (destino < 0) return;
      e.preventDefault();
      abas[destino].click();
      abas[destino].focus();
    });

    const daUrl = () => Math.max(0, abas.findIndex((a) => `#${a.dataset.aba}` === location.hash));
    selecionar(daUrl());
    window.addEventListener("hashchange", () => selecionar(daUrl()));
  }
</script>

<style>
  /* O perfil fica estreito; os cursos (carrossel e cards) usam a largura toda. */
  .hub-container {
    max-width: 992px;
    margin: 0 auto;
    padding: 48px 32px;
    position: relative;
    z-index: 1;
  }

  /* ── Profile section ── */
  .hub-profile {
    max-width: 416px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .mentor-photo {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    border: 2px solid var(--nucleo-eletrico);
    box-shadow: 0 0 16px rgb(var(--rgb-ciano) / 0.3);
    object-fit: cover;
  }

  h1 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--texto-principal);
    margin: 0;
  }

  .bio {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--texto-secundario);
    margin: 0;
  }

  /* ── Social links ── */
  .social-links {
    display: flex;
    flex-direction: row;
    gap: 16px;
    justify-content: center;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    color: var(--texto-terciario);
    text-decoration: none;
    transition: color 0.2s ease, filter 0.2s ease;
    border-radius: 4px;
  }

  .social-icon-link:hover {
    color: var(--nucleo-eletrico);
    filter: drop-shadow(0 0 6px rgb(var(--rgb-ciano) / 0.6));
  }

  /* ── Divider ── */
  .hub-divider {
    border: none;
    border-top: 1px solid var(--hairline-strong);
    max-width: 416px;
    margin: 24px auto;
  }

  /* ── Courses section ── */
  .hub-courses {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hub-courses h2 {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--texto-principal);
    margin: 0 0 8px 0;
  }

  /* ── Abas ── */
  .hub-abas {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    border-bottom: 1px solid var(--hairline-strong);
    margin-bottom: 24px;
  }

  .hub-abas[hidden] {
    display: none;
  }

  .hub-abas [role="tab"] {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    background: none;
    color: var(--texto-secundario);
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    cursor: pointer;
  }

  .hub-abas [role="tab"]:hover {
    color: var(--texto-principal);
  }

  .hub-abas [role="tab"][aria-selected="true"] {
    color: var(--texto-principal);
    border-bottom-color: var(--nucleo-eletrico);
  }

  .aba-contador {
    min-width: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--chama-primaria);
    color: #ffffff;
    font-size: 0.75rem;
    line-height: 22px;
    text-align: center;
  }

  .hub-painel + .hub-painel {
    margin-top: 48px;
  }

  .hub-painel[hidden] {
    display: none;
  }

  .hub-painel:focus-visible {
    outline-offset: 8px;
  }

  .event-meta {
    display: grid;
    gap: 4px;
    margin: 0 0 12px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--texto-principal);
  }

  .event-meta div {
    display: flex;
    gap: 8px;
  }

  .event-meta dt {
    min-width: 64px;
    color: var(--texto-terciario);
  }

  .event-meta dd {
    margin: 0;
  }

  .course-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 24px;
  }

  .course-card {
    display: flex;
    flex-direction: column;
  }

  .course-actions {
    margin-top: auto;
  }

  .course-card {
    background: rgb(var(--rgb-cartao) / 0.6);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    padding: 24px;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .course-card.active:hover {
    border-color: var(--hairline-strong);
    background: rgb(var(--rgb-cartao) / 0.85);
    transform: translateY(-2px);
  }

  .course-card.coming-soon {
    opacity: 0.7;
    cursor: default;
  }

  .course-card.coming-soon .course-link {
    pointer-events: none;
  }

  .course-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .course-title {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--texto-principal);
    margin: 0;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: 2px 8px;
    border-radius: 2px;
    white-space: nowrap;
  }

  .badge-active {
    color: var(--sucesso);
    border: 1px solid var(--sucesso);
  }

  .badge-coming-soon {
    color: var(--alerta);
    border: 1px solid var(--alerta);
  }

  .course-description {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--texto-secundario);
    margin: 0 0 16px 0;
  }

  .course-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  /* Alvos de toque de 44px (WCAG 2.5.5) */
  .course-link,
  .course-star {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .course-link {
    background: var(--chama-primaria);
    color: #ffffff;
  }

  .course-link:hover {
    background: var(--chama-hover);
  }

  .course-star {
    border: 1px solid var(--hairline-strong);
    color: var(--texto-principal);
  }

  .course-star svg {
    color: var(--alerta);
  }

  .course-star:hover {
    border-color: var(--nucleo-eletrico);
    color: var(--nucleo-eletrico);
  }

  .hub-footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    padding: 0 16px 80px;
  }

  .hub-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--texto-secundario);
  }

  .hub-footer a:hover {
    color: var(--nucleo-eletrico);
  }

  /* ── Responsive: mobile ── */
  @media (max-width: 480px) {
    .mentor-photo {
      width: 96px;
      height: 96px;
    }

    .hub-container {
      padding: 48px 16px;
    }

    .course-card {
      padding: 16px;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .social-icon-link {
      transition: none;
    }

    .social-icon-link:hover {
      filter: none;
    }

    .course-card {
      transition: none;
    }

    .course-card.active:hover {
      transform: none;
    }
  }
</style>

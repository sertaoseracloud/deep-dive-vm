---
import Layout from "../layouts/Layout.astro";

import UrgencyBar from "../components/layout/UrgencyBar.astro";
import NavBar from "../components/layout/NavBar.astro";
import Footer from "../components/layout/Footer.astro";
import StickyCta from "../components/layout/StickyCta.astro";

import Hero from "../components/sections/Hero.astro";
import TrustBand from "../components/sections/TrustBand.astro";
import PainPoints from "../components/sections/PainPoints.astro";
import Method from "../components/sections/Method.astro";
import Curriculum from "../components/sections/Curriculum.astro";
import Mentor from "../components/sections/Mentor.astro";
import ForWho from "../components/sections/ForWho.astro";
import Bonuses from "../components/sections/Bonuses.astro";
import Pricing from "../components/sections/Pricing.astro";
import Faq from "../components/sections/Faq.astro";
import LegalModals from "../components/ui/LegalModals.astro";

import React from "react";
import { CarouselMotion } from "../components/CarouselMotion";
import { HeroMotion } from "../components/HeroMotion";
import { MobileMenuMotion } from "../components/MobileMenuMotion";
import { SettingsToggle } from "../components/SettingsToggle";
import { TestimonialCard } from "../components/TestimonialCard";
import type { TestimonialData } from "../components/TestimonialCard";

const testimonials: TestimonialData[] = [
  {
    id: "rafael-m",
    initials: "RM",
    quote: "O módulo de Zero Trust e Bastion sozinho já pagou a mentoria. Em 3 semanas reescrevi a topologia de rede do meu cliente em Terraform · e fechei um aumento de R$ 4k no contrato.",
    name: "Rafael M.",
    role: "SR. CLOUD ENGINEER · FINTECH",
  },
  {
    id: "juliana-s",
    initials: "JS",
    quote: "Eu já era Senior, mas não conseguia explicar arquitetura para diretoria. O método de '4 frentes' me deu vocabulário e visão sistêmica. Saí pronto para o cargo de Arquiteto.",
    name: "Juliana S.",
    role: "CLOUD ARCHITECT · SAAS B2B",
  },
  {
    id: "diego-a",
    initials: "DA",
    quote: "Spot VMs + Reserved + auto-shutdown via CLI cortou 38% do meu billing mensal no primeiro mês. Cláudio mostra o 'por quê' antes do 'como' · isso muda o jogo.",
    name: "Diego A.",
    role: "DEVOPS LEAD · CONSULTORIA",
  },
];

const carouselItems = testimonials.map(t => ({
  id: t.id,
  content: React.createElement(TestimonialCard, { data: t }),
}));
---

<Layout
	title="Deep Dive Azure VM · O Sertao será Cloud"
	description="Formação de 54h para Engenheiros dominarem Azure VMs · Portal, CLI e Terraform · com Cláudio Raposo, Microsoft MVP."
	url={Astro.url.toString()}
>
	<a href="#main" class="skip-link">Pular para o conteúdo</a>
	<UrgencyBar />
	<NavBar />
	<MobileMenuMotion client:load />
	<main id="main" tabindex="-1">
		<HeroMotion client:visible><Hero /></HeroMotion>
		<TrustBand />
		<PainPoints />
		<Method />
		<Curriculum />
		<Mentor />
		<ForWho />
		<Bonuses />
		<CarouselMotion client:load items={carouselItems} />
		<Pricing />
		<Faq />
		<Footer />
		<StickyCta />
		<LegalModals />
		<div class="motion-settings">
			<SettingsToggle client:load />
		</div>
	</main>
</Layout>

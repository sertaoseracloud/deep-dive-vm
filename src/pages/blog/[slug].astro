---
// Um artigo do blog dentro do site. O texto vem do dev.to (pipeline diária,
// scripts/buscar-devto.mjs) e a URL canônica aponta para lá: os buscadores
// tratam o dev.to como a origem e esta página não conta como conteúdo
// duplicado. Por isso as páginas do blog também ficam fora do sitemap.
import Layout from "../../layouts/Layout.astro";
import artigos from "../../data/devto-artigos.json";
import type { Artigo } from "../../lib/devto.js";
import { dataCurta, limparHtml, nomeDoIdioma, PERFIL } from "../../lib/devto.js";
import "../../styles/artigo.css";

export function getStaticPaths() {
  const corpos = import.meta.glob<string>("../../data/devto/*.html", { query: "?raw", import: "default", eager: true });
  return (artigos as Artigo[]).map((artigo, i) => ({
    params: { slug: artigo.slug },
    props: {
      artigo,
      html: limparHtml(corpos[`../../data/devto/${artigo.id}.html`] ?? ""),
      anterior: (artigos as Artigo[])[i + 1] ?? null, // mais antigo
      proximo: (artigos as Artigo[])[i - 1] ?? null, // mais novo
    },
  }));
}

interface Props {
  artigo: Artigo;
  html: string;
  anterior: Artigo | null;
  proximo: Artigo | null;
}

const { artigo, html, anterior, proximo } = Astro.props;
const lang = artigo.language === "pt" ? undefined : artigo.language;
---

<Layout
  title={`${artigo.title} · O Sertão será Cloud`}
  description={artigo.description || artigo.title}
  url={artigo.canonical}
  ogImage={artigo.cover ?? "/hub-og.png"}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: artigo.title,
    description: artigo.description,
    datePublished: artigo.publishedAt,
    dateModified: artigo.editedAt,
    inLanguage: artigo.language,
    keywords: artigo.tags.join(", "),
    mainEntityOfPage: artigo.canonical,
    url: artigo.canonical,
    ...(artigo.cover ? { image: artigo.cover } : {}),
    author: { "@type": "Person", name: "Cláudio Filipe Lima Rapôso", url: "https://mentoria.sertaoseracloud.com/" },
  }}
>
  <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo</a>

  <main id="conteudo-principal" tabindex="-1">
    <article class="artigo" lang={lang}>
      <nav class="artigo-trilha" aria-label="Você está em" lang="pt-BR">
        <a href="/#blog"><span aria-hidden="true">←</span> Blog</a>
      </nav>

      <header class="artigo-cabecalho">
        <p class="artigo-meta" lang="pt-BR">
          <time datetime={artigo.publishedAt}>{dataCurta(artigo.publishedAt)}</time>
          <span aria-hidden="true"> · </span>{artigo.readingTime} min de leitura
          <span aria-hidden="true"> · </span>{nomeDoIdioma(artigo.language)}
        </p>
        <h1>{artigo.title}</h1>
        {artigo.description && <p class="artigo-resumo">{artigo.description}</p>}
        {artigo.tags.length > 0 && (
          <ul class="artigo-tags" aria-label="Tags" lang="pt-BR">
            {artigo.tags.map((tag) => <li>#{tag}</li>)}
          </ul>
        )}
        <p class="artigo-origem" lang="pt-BR">
          Publicado originalmente no{" "}
          <a href={artigo.url} target="_blank" rel="noopener noreferrer">dev.to<span class="sr-only"> (abre em nova aba)</span></a>{" "}
          por Cláudio Rapôso. Comentários e reações ficam por lá.
        </p>
      </header>

      {artigo.cover && <img class="artigo-capa" src={artigo.cover} alt="" width="1000" height="420" decoding="async" />}

      <div class="artigo-corpo" set:html={html} />

      <footer class="artigo-rodape" lang="pt-BR">
        <p class="artigo-acoes">
          <a href={artigo.url} class="artigo-botao" target="_blank" rel="noopener noreferrer">
            Comentar ou reagir no dev.to<span aria-hidden="true"> →</span><span class="sr-only"> (abre em nova aba)</span>
          </a>
          <a href={PERFIL} target="_blank" rel="noopener noreferrer">Todos os artigos no dev.to<span class="sr-only"> (abre em nova aba)</span></a>
        </p>
        {(anterior || proximo) && (
          <nav class="artigo-vizinhos" aria-label="Outros artigos">
            {proximo && (
              <a href={`/blog/${proximo.slug}/`} rel="next">
                <span class="artigo-vizinho-rotulo">Mais recente</span>
                <span lang={proximo.language === "pt" ? undefined : proximo.language}>{proximo.title}</span>
              </a>
            )}
            {anterior && (
              <a href={`/blog/${anterior.slug}/`} rel="prev">
                <span class="artigo-vizinho-rotulo">Mais antigo</span>
                <span lang={anterior.language === "pt" ? undefined : anterior.language}>{anterior.title}</span>
              </a>
            )}
          </nav>
        )}
      </footer>
    </article>
  </main>
</Layout>

<script>
  // Diagramas Mermaid (```mermaid no dev.to): viram desenho SVG nas cores do
  // tema do painel ♿, com o código logo abaixo num <details>. A biblioteca só
  // é baixada nas páginas que têm diagrama. Sem JavaScript, ou se a fonte tiver
  // erro, o bloco continua aparecendo como código.
  import { rotuloDoDiagrama, SELETOR_MERMAID, tipoDoDiagrama, tituloAcessivel, variaveisDoTema } from "../../lib/diagramas";

  const blocos = [...document.querySelectorAll<HTMLElement>(SELETOR_MERMAID)];
  if (blocos.length > 0) {
    const figuras = blocos.map((pre, i) => {
      const fonte = (pre.textContent ?? "").trim();
      const titulo = tituloAcessivel(fonte);
      const rotulo = rotuloDoDiagrama(tipoDoDiagrama(fonte)) + (titulo ? `: ${titulo}` : "");

      const figura = document.createElement("figure");
      figura.className = "diagrama";
      figura.setAttribute("aria-label", rotulo);
      const desenho = document.createElement("div");
      desenho.className = "diagrama-desenho";
      desenho.hidden = true;
      // Diagramas largos rolam na horizontal: precisam de foco pelo teclado.
      desenho.tabIndex = 0;
      desenho.setAttribute("role", "group");
      desenho.setAttribute("aria-label", rotulo);
      const dica = document.createElement("p");
      dica.className = "diagrama-dica";
      dica.hidden = true;
      dica.textContent = "O diagrama continua para o lado: role na horizontal ou use as setas do teclado depois de selecioná-lo.";
      const detalhes = document.createElement("details");
      detalhes.className = "diagrama-codigo";
      const resumo = document.createElement("summary");
      resumo.textContent = "Ver o código do diagrama";

      pre.replaceWith(figura);
      detalhes.append(resumo, pre);
      figura.append(desenho, dica, detalhes);
      return { id: `diagrama-${i}`, fonte, desenho, dica, detalhes };
    });

    // A dica só aparece quando o diagrama não cabe na largura do texto.
    const conferirLargura = () => {
      for (const f of figuras) f.dica.hidden = f.desenho.hidden || f.desenho.scrollWidth <= f.desenho.clientWidth + 4;
    };
    addEventListener("resize", conferirLargura);

    let mermaid: typeof import("mermaid").default | undefined;
    let rodada = 0;

    const desenhar = async () => {
      const esta = ++rodada;
      mermaid ??= (await import("mermaid")).default;
      const css = getComputedStyle(document.documentElement);
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        theme: "base",
        themeVariables: variaveisDoTema((nome) => css.getPropertyValue(nome).trim()),
        // Tamanho real (letra de 15 px): diagramas largos rolam dentro do
        // quadro em vez de encolher até ficarem ilegíveis.
        flowchart: { htmlLabels: false, useMaxWidth: false },
        sequence: { useMaxWidth: false },
      });
      for (const f of figuras) {
        if (esta !== rodada) return; // o tema mudou de novo no meio do caminho
        const valido = await mermaid.parse(f.fonte, { suppressErrors: true });
        if (!valido) {
          f.desenho.hidden = true;
          f.detalhes.open = true;
          continue;
        }
        const { svg } = await mermaid.render(`${f.id}-${esta}`, f.fonte);
        f.desenho.innerHTML = svg;
        f.desenho.hidden = false;
      }
      conferirLargura();
    };

    // A biblioteca é pesada (~1 MB): só é baixada e executada quando um
    // diagrama chega perto da tela, para não travar a abertura da página.
    const observador = new IntersectionObserver(
      (entradas) => {
        if (!entradas.some((e) => e.isIntersecting)) return;
        observador.disconnect();
        desenhar();
      },
      { rootMargin: "400px 0px" },
    );
    figuras.forEach((f) => observador.observe(f.desenho.parentElement!));

    // Redesenha quando o tema ou a fonte mudam no painel ♿ (se já desenhou).
    new MutationObserver(() => mermaid && desenhar()).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-tema", "class"],
    });
  }
</script>

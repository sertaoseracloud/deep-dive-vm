---
import { SEO } from "astro-seo";
import { Font } from "astro:assets";
import claudio1 from "../assets/claudio1.png";
import AccessibilityPanel from "../components/ui/AccessibilityPanel.astro";
import { CHAVE_APLICADO, COR_DA_BARRA } from "../lib/preferencias";

interface Props {
	title: string;
	description?: string;
	url?: string;
	offersUrl?: string;
	ogImage?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>;
}

const { title, description, url, offersUrl, ogImage, noindex, jsonLd } = Astro.props;

const siteOrigin = "https://mentoria.sertaoseracloud.com";
const ogImageUrl = ogImage
	? `${siteOrigin}${ogImage}`
	: `${siteOrigin}${claudio1.src}`;
const resolvedDescription = description ?? "Formação técnica de alto impacto em cloud. Aprenda com Cláudio Raposo, Microsoft MVP.";
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="theme-color" content={COR_DA_BARRA.padrao} />
		<!-- Reaplica a escolha do painel ♿ antes da primeira pintura (sem piscar o tema). -->
		<script is:inline define:vars={{ chave: CHAVE_APLICADO }}>
			try {
				var a = JSON.parse(localStorage.getItem(chave));
				if (a) {
					var r = document.documentElement;
					r.setAttribute("data-tema", a.tema);
					r.style.setProperty("--escala", a.escala);
					a.classes.forEach(function (c) { r.classList.add(c); });
					document.querySelector('meta[name="theme-color"]').setAttribute("content", a.cor);
				}
			} catch (e) {}
		</script>
		<SEO
			title={title}
			description={resolvedDescription}
			noindex={noindex ?? false}
			openGraph={{
				basic: {
					title: title,
					type: "website",
					image: ogImageUrl,
				},
				optional: {
					description: resolvedDescription,
				},
				image: {
					alt: "Mentoria O Sertao será Cloud - Deep Dive Azure VM",
				},
			}}
			twitter={{
				creator: "@sertaoseracloud",
				card: "summary_large_image",
			}}
			extend={{
				link: [
					{
						rel: "icon",
						type: "image/x-icon",
						href: "/favicon.ico",
					},
					{ rel: "canonical", href: url ?? Astro.url.href },
				],
				meta: [
					{
						name: "twitter:image",
						content: ogImageUrl,
					},
					{ name: "twitter:title", content: title },
					{ name: "twitter:description", content: resolvedDescription },
					{
						name: "viewport",
						content: "width=device-width, initial-scale=1",
					},
					{
						name: "keywords",
						content:
							"O Sertão será Cloud, Deep Dive Azure VM, Arquiteto de Nuvem, Microsoft MVP, Cláudio Rapôso, Terraform Azure, Azure CLI, Spec-Driven Development, Well-Architected Framework, Zero Trust Azure, FinOps Azure, Cloud Architecture",
					},
				],
			}}
		/>

		<!-- Pré-carrega só o que aparece acima da dobra; o resto chega sob demanda. -->
		<Font cssVariable="--font-body" preload={[{ style: "normal", subset: "latin" }]} />
		<Font cssVariable="--font-display" preload={[{ weight: 700, style: "normal", subset: "latin" }]} />
		<Font cssVariable="--font-mono" preload={[{ style: "normal", subset: "latin" }]} />
		<Font cssVariable="--font-legivel" />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<slot name="head" />
	</head>
	<body>
		<div class="ambient" aria-hidden="true"></div>
		<slot />
		<AccessibilityPanel />
		<script>
			const revealEls = document.querySelectorAll("[data-reveal]");
			if (revealEls.length > 0) {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.setAttribute("data-revealed", "");
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.15 }
				);
				revealEls.forEach((el) => observer.observe(el));
				document.addEventListener(
					"astro:before-swap",
					() => observer.disconnect(),
					{ once: true }
				);
			}
		</script>
	</body>
</html>

<style is:global>
	/* Skip-link: hidden off-screen, revealed on focus */
	.skip-link {
		position: absolute;
		top: -100%;
		left: 0;
		z-index: 9999;
		padding: 0.5rem 1rem;
		background: var(--abismo-profundo, #000);
		color: var(--nucleo-eletrico, #0ff);
		font-size: 0.875rem;
		text-decoration: none;
		border: 1px solid currentColor;
		transition: top 0.2s;
	}
	.skip-link:focus {
		top: 0;
	}

	/* Tamanho do texto do painel ♿: todas as fontes do site estão em rem. */
	html {
		font-size: calc(100% * var(--escala, 1));
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	/* Foco do teclado sempre visível (WCAG 2.4.7); :where() deixa os
	   componentes refinarem sem brigar por especificidade. */
	:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
		outline: 2px solid var(--nucleo-eletrico);
		outline-offset: 2px;
	}

	:root {
		--chama-primaria: #1a3ac8;
		--chama-hover: #2548e0;
		--nucleo-eletrico: #00ffff;
		--abismo-profundo: #0a0f1e;
		--sub-nivel: #1b293c;
		--neutro-escuro: #000000;
		--texto-principal: #ffffff;
		--texto-secundario: #d1d9e6;
		--texto-terciario: #8a99b5;
		--sucesso: #00e5a8;
		--alerta: #ffb547;

		/* Variável crítica para a renderização da grade */
		--grid-line: rgba(0, 255, 255, 0.05);
		--hairline: rgba(209, 217, 230, 0.12);
		--hairline-strong: rgba(0, 255, 255, 0.32);

		/* Easing tokens — ANIM-03 */
		--ease-entrance: cubic-bezier(0.25, 1, 0.5, 1);
		--ease-micro: cubic-bezier(0.0, 0.0, 0.2, 1);
	}

	/* ————————————————————————————————
	   Temas do painel ♿. Sem escolha salva (:root sem data-tema), o sistema
	   operacional decide: contraste alto ou cores forçadas → alto contraste.
	   ———————————————————————————————— */
	:root[data-tema="alto-contraste"] {
		--chama-primaria: #0033cc;
		--chama-hover: #0040ff;
		--nucleo-eletrico: #ffff00;
		--abismo-profundo: #000000;
		--sub-nivel: #000000;
		--texto-principal: #ffffff;
		--texto-secundario: #ffffff;
		--texto-terciario: #f0f0f0;
		--sucesso: #3dff9e;
		--alerta: #ffc04d;
		--grid-line: transparent;
		--hairline: rgba(255, 255, 255, 0.7);
		--hairline-strong: #ffff00;
	}

	@media (prefers-contrast: more) {
		:root:not([data-tema]) {
			--chama-primaria: #0033cc;
			--chama-hover: #0040ff;
			--nucleo-eletrico: #ffff00;
			--abismo-profundo: #000000;
			--sub-nivel: #000000;
			--texto-principal: #ffffff;
			--texto-secundario: #ffffff;
			--texto-terciario: #f0f0f0;
			--grid-line: transparent;
			--hairline: rgba(255, 255, 255, 0.7);
			--hairline-strong: #ffff00;
		}
	}

	:root[data-tema="suave"] {
		--chama-primaria: #3b5a9a;
		--chama-hover: #4867a8;
		--nucleo-eletrico: #8cc7c7;
		--abismo-profundo: #1c2128;
		--sub-nivel: #252b34;
		--texto-principal: #e6e9ee;
		--texto-secundario: #c9d0db;
		--texto-terciario: #a3adbd;
		--sucesso: #8fcfb3;
		--alerta: #dcbb80;
		--grid-line: transparent;
		--hairline: rgba(220, 225, 235, 0.16);
		--hairline-strong: rgba(140, 199, 199, 0.45);
	}

	/* Sem brilho, gradiente nem grade nos temas de alto contraste e suave. */
	:root[data-tema="alto-contraste"] .ambient,
	:root[data-tema="suave"] .ambient {
		background: var(--abismo-profundo);
	}

	:root[data-tema="alto-contraste"] .hero::before,
	:root[data-tema="suave"] .hero::before {
		display: none;
	}

	:root[data-tema="alto-contraste"] *,
	:root[data-tema="suave"] * {
		text-shadow: none !important;
	}

	:root[data-tema="alto-contraste"] :where(a, button, input, summary, [tabindex]):focus-visible {
		outline-width: 3px;
	}

	/* Opções de leitura (WCAG 1.4.8 e 1.4.12) */
	:root.a11y-fonte-legivel body,
	:root.a11y-fonte-legivel body :not(code, pre, kbd, samp) {
		font-family: var(--font-legivel) !important;
	}

	:root.a11y-espacamento body :is(p, li, dd, dt, label, .course-description) {
		line-height: 1.8 !important;
		letter-spacing: 0.04em !important;
		word-spacing: 0.16em !important;
	}

	:root.a11y-espacamento body :is(p, ul, ol) {
		margin-bottom: 1.25em;
	}

	:root.a11y-linhas-curtas body :is(p, li, dd) {
		max-width: 65ch;
	}

	:root.a11y-links body a,
	:root.a11y-links body .link-btn {
		text-decoration: underline !important;
		text-underline-offset: 3px;
	}

	:root.a11y-links :where(a, button, input, summary, [tabindex]):focus-visible {
		outline-width: 4px !important;
	}

	/* Reduzir animações: pelo painel ou pelo sistema operacional. */
	:root.a11y-sem-movimento *,
	:root.a11y-sem-movimento *::before,
	:root.a11y-sem-movimento *::after {
		animation-duration: 0.001ms !important;
		animation-iteration-count: 1 !important;
		transition-duration: 0.001ms !important;
		scroll-behavior: auto !important;
	}

	:root.a11y-sem-movimento [data-reveal],
	:root.a11y-sem-movimento [data-stagger] {
		opacity: 1 !important;
		transform: none !important;
		animation: none !important;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto !important;
		}
	}

	/* Cores forçadas (Alto contraste do Windows): bordas visíveis nos cartões. */
	@media (forced-colors: active) {
		.ambient {
			display: none;
		}
		:where(a, button, input, summary, [tabindex]):focus-visible {
			outline: 3px solid CanvasText;
		}
	}

	/* Scroll reveal — ANIM-02 */
	[data-reveal] {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 400ms var(--ease-entrance),
			transform 400ms var(--ease-entrance);
	}

	[data-reveal][data-revealed] {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-reveal] {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	@keyframes fade-up {
		from { opacity: 0; transform: translateY(16px); }
		to { opacity: 1; transform: none; }
	}

	[data-stagger] {
		animation: fade-up 400ms var(--ease-entrance) forwards;
		animation-play-state: paused;
	}

	[data-revealed] [data-stagger] {
		animation-play-state: running;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-stagger] { animation: none; opacity: 1; transform: none; }
	}

	body {
		margin: 0;
		padding: 0;
		background-color: var(--abismo-profundo);
		color: var(--texto-principal);
		font-family: var(--font-body);
		min-height: 100vh;
		overflow-x: hidden;
		overflow-wrap: break-word;
	}

	/* O fundo radial original */
	.ambient {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(
				ellipse 60% 45% at 18% 12%,
				rgba(0, 180, 255, 0.18),
				transparent 60%
			),
			radial-gradient(
				ellipse 70% 55% at 82% 100%,
				rgba(26, 58, 200, 0.22),
				transparent 65%
			),
			var(--abismo-profundo);
	}

	/* Renderização da Malha de Grade (Grid) */
	.ambient::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(var(--grid-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
		background-size: 56px 56px;
		mask-image: radial-gradient(
			ellipse 70% 70% at 50% 30%,
			black 30%,
			transparent 85%
		);
		-webkit-mask-image: radial-gradient(
			ellipse 70% 70% at 50% 30%,
			black 30%,
			transparent 85%
		);
	}

	.container {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 32px;
	}

	@media (max-width: 480px) {
		.container {
			padding: 0 16px;
		}
	}
	/* ————————————————————————————————
     Section primitives (Fiel ao original)
  ———————————————————————————————— */
	section {
		position: relative;
		z-index: 1;
		padding: 96px 0;
		background: transparent; /* Garante a visibilidade do fundo ambient */
	}

	@media (max-width: 720px) {
		section {
			padding: 64px 0;
		}
	}
</style>

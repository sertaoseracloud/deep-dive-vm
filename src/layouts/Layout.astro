---
import { SEO } from "astro-seo";
import { Font } from "astro:assets";
import AccessibilityPanel from "../components/ui/AccessibilityPanel.astro";
import { CHAVE_APLICADO, COR_DA_BARRA } from "../lib/preferencias";

interface Props {
	title: string;
	description?: string;
	url?: string;
	ogImage?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>;
}

const { title, description, url, ogImage, noindex, jsonLd } = Astro.props;

const siteOrigin = "https://mentoria.sertaoseracloud.com";
// ogImage pode ser um caminho do site ("/hub-og.png") ou uma URL completa
// (capa de um artigo no dev.to).
const ogImageUrl = ogImage
	? (/^https?:\/\//.test(ogImage) ? ogImage : `${siteOrigin}${ogImage}`)
	: `${siteOrigin}/hub-og.png`;
const resolvedDescription = description ?? "Cursos gratuitos e acessíveis e eventos da comunidade com Cláudio Rapôso, Microsoft MVP.";
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="theme-color" content={COR_DA_BARRA.padrao} />
		<!-- Reaplica a escolha do painel ♿ antes da primeira pintura (sem piscar o tema).
		     Sem escolha salva, segue o sistema: contraste alto/cores forçadas ou modo claro. -->
		<script is:inline define:vars={{ chave: CHAVE_APLICADO, cores: COR_DA_BARRA }}>
			try {
				var a = null;
				try { a = JSON.parse(localStorage.getItem(chave)); } catch (e) {}
				if (!a && window.matchMedia) {
					var m = function (q) { return matchMedia(q).matches; };
					var tema = m("(prefers-contrast: more)") || m("(forced-colors: active)")
						? "alto-contraste"
						: m("(prefers-color-scheme: light)") ? "claro" : null;
					if (tema) a = { tema: tema, escala: "1", classes: [], cor: cores[tema] };
				}
				if (a) {
					var r = document.documentElement;
					r.setAttribute("data-tema", a.tema);
					r.style.setProperty("--escala", a.escala);
					a.classes.forEach(function (c) { r.classList.add(c); });
					document.querySelector('meta[name="theme-color"]').setAttribute("content", a.cor);
				}
			} catch (e) {}
		</script>
		<!-- Um único canonical (o astro-seo gera o seu; não repetir no extend).
		     Nos artigos do blog ele aponta para o dev.to. -->
		<SEO
			title={title}
			description={resolvedDescription}
			noindex={noindex ?? false}
			canonical={url ?? Astro.url.href}
			openGraph={{
				basic: {
					title: title,
					type: "website",
					image: ogImageUrl,
					url: url ?? Astro.url.href,
				},
				optional: {
					description: resolvedDescription,
				},
				image: {
					alt: "O Sertão será Cloud: cursos gratuitos e eventos com Cláudio Rapôso",
				},
			}}
			twitter={{
				creator: "@sertaoseracloud",
				card: "summary_large_image",
			}}
			extend={{
				link: [
					{
						rel: "icon",
						type: "image/x-icon",
						href: "/favicon.ico",
					},
				],
				meta: [
					{
						name: "twitter:image",
						content: ogImageUrl,
					},
					{ name: "twitter:title", content: title },
					{ name: "twitter:description", content: resolvedDescription },
					{
						name: "viewport",
						content: "width=device-width, initial-scale=1",
					},
					{
						name: "keywords",
						content:
							"O Sertão será Cloud, Cláudio Rapôso, Microsoft MVP, cursos gratuitos, acessibilidade, DivergePHP, DivergeTerraform, DivergePython, DivergeKubernetes, MVPConf, eventos de tecnologia",
					},
				],
			}}
		/>

		<!-- Pré-carrega só o que aparece acima da dobra; o resto chega sob demanda. -->
		<Font cssVariable="--font-body" preload={[{ style: "normal", subset: "latin" }]} />
		<Font cssVariable="--font-display" preload={[{ weight: 700, style: "normal", subset: "latin" }]} />
		<Font cssVariable="--font-mono" preload={[{ style: "normal", subset: "latin" }]} />
		<Font cssVariable="--font-legivel" />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<slot name="head" />
	</head>
	<body>
		<div class="ambient" aria-hidden="true"></div>
		<slot />
		<AccessibilityPanel />
	</body>
</html>

<style is:global>
	/* Skip-link: hidden off-screen, revealed on focus */
	.skip-link {
		position: absolute;
		top: -100%;
		left: 0;
		z-index: 9999;
		padding: 0.5rem 1rem;
		background: var(--abismo-profundo, #000);
		color: var(--nucleo-eletrico, #0ff);
		font-size: 0.875rem;
		text-decoration: none;
		border: 1px solid currentColor;
		transition: top 0.2s;
	}
	.skip-link:focus {
		top: 0;
	}

	/* Tamanho do texto do painel ♿: todas as fontes do site estão em rem. */
	html {
		font-size: calc(100% * var(--escala, 1));
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	/* Foco do teclado sempre visível (WCAG 2.4.7); :where() deixa os
	   componentes refinarem sem brigar por especificidade. */
	:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
		outline: 2px solid var(--nucleo-eletrico);
		outline-offset: 2px;
	}

	:root {
		--chama-primaria: #1a3ac8;
		--chama-hover: #2548e0;
		--nucleo-eletrico: #00ffff;
		--abismo-profundo: #0a0f1e;
		--sub-nivel: #1b293c;
		--texto-principal: #ffffff;
		--texto-secundario: #d1d9e6;
		--texto-terciario: #8a99b5;
		--sucesso: #00e5a8;
		--alerta: #ffb547;

		/* Variável crítica para a renderização da grade */
		--grid-line: rgb(var(--rgb-ciano) / 0.05);
		--hairline: rgb(var(--rgb-texto) / 0.12);
		--hairline-strong: rgb(var(--rgb-ciano) / 0.32);

		/* Canais RGB das cores com transparência dos componentes:
		   rgb(var(--rgb-ciano) / 0.3). Cada tema redefine os canais. */
		--rgb-ciano: 0 255 255;
		--rgb-cartao: 27 41 60;
		--rgb-texto: 209 217 230;
		--rgb-sombra: 0 0 0;
		--rgb-claro: 255 255 255;
		--rgb-cobalto: 26 58 200;
		--rgb-ceu: 0 180 255;

	}

	/* ————————————————————————————————
	   Temas do painel ♿. Sem escolha salva (:root sem data-tema), o sistema
	   operacional decide: contraste alto ou cores forçadas → alto contraste.
	   ———————————————————————————————— */
	:root[data-tema="alto-contraste"] {
		--chama-primaria: #0033cc;
		--chama-hover: #0040ff;
		--nucleo-eletrico: #ffff00;
		--abismo-profundo: #000000;
		--sub-nivel: #000000;
		--texto-principal: #ffffff;
		--texto-secundario: #ffffff;
		--texto-terciario: #f0f0f0;
		--sucesso: #3dff9e;
		--alerta: #ffc04d;
		--grid-line: transparent;
		--hairline: rgb(var(--rgb-claro) / 0.7);
		--hairline-strong: #ffff00;
		--rgb-ciano: 255 255 0;
	}

	:root[data-tema="suave"] {
		--chama-primaria: #3b5a9a;
		--chama-hover: #4867a8;
		--nucleo-eletrico: #8cc7c7;
		--abismo-profundo: #1c2128;
		--sub-nivel: #252b34;
		--texto-principal: #e6e9ee;
		--texto-secundario: #c9d0db;
		--texto-terciario: #a3adbd;
		--sucesso: #8fcfb3;
		--alerta: #dcbb80;
		--grid-line: transparent;
		--hairline: rgb(var(--rgb-texto) / 0.16);
		--hairline-strong: rgb(var(--rgb-ciano) / 0.45);
		--rgb-ciano: 140 199 199;
		--rgb-cartao: 37 43 52;
	}

	:root[data-tema="claro"] {
		--chama-primaria: #1a3ac8;
		--chama-hover: #2548e0;
		--nucleo-eletrico: #00636b;
		--abismo-profundo: #f5f7fb;
		--sub-nivel: #ffffff;
		--texto-principal: #0b1220;
		--texto-secundario: #2c3a52;
		--texto-terciario: #4a5873;
		--sucesso: #00684b;
		--alerta: #8a5300;
		--grid-line: rgb(var(--rgb-ciano) / 0.06);
		--hairline: rgb(11 18 32 / 0.14);
		--hairline-strong: rgb(var(--rgb-ciano) / 0.45);
		--rgb-ciano: 0 99 107;
		--rgb-cartao: 255 255 255;
		--rgb-texto: 44 58 82;
		--rgb-sombra: 15 23 42;
		--rgb-claro: 11 18 32;
		--rgb-cobalto: 26 58 200;
		--rgb-ceu: 0 120 200;
		color-scheme: light;
	}

	/* Sem brilho, gradiente nem grade nos temas de alto contraste e suave. */
	:root[data-tema="alto-contraste"] .ambient,
	:root[data-tema="suave"] .ambient,
	:root[data-tema="claro"] .ambient {
		background: var(--abismo-profundo);
	}

	:root[data-tema="alto-contraste"] *,
	:root[data-tema="suave"] *,
	:root[data-tema="claro"] * {
		text-shadow: none !important;
	}

	:root[data-tema="alto-contraste"] :where(a, button, input, summary, [tabindex]):focus-visible {
		outline-width: 3px;
	}

	/* Opções de leitura (WCAG 1.4.8 e 1.4.12) */
	:root.a11y-fonte-legivel body,
	:root.a11y-fonte-legivel body :not(code, pre, kbd, samp) {
		font-family: var(--font-legivel) !important;
	}

	:root.a11y-espacamento body :is(p, li, dd, dt, label, .course-description) {
		line-height: 1.8 !important;
		letter-spacing: 0.04em !important;
		word-spacing: 0.16em !important;
	}

	:root.a11y-espacamento body :is(p, ul, ol) {
		margin-bottom: 1.25em;
	}

	:root.a11y-linhas-curtas body :is(p, li, dd) {
		max-width: 65ch;
	}

	:root.a11y-links body a,
	:root.a11y-links body .link-btn {
		text-decoration: underline !important;
		text-underline-offset: 3px;
	}

	:root.a11y-links :where(a, button, input, summary, [tabindex]):focus-visible {
		outline-width: 4px !important;
	}

	/* Reduzir animações: pelo painel ou pelo sistema operacional. */
	:root.a11y-sem-movimento *,
	:root.a11y-sem-movimento *::before,
	:root.a11y-sem-movimento *::after {
		animation-duration: 0.001ms !important;
		animation-iteration-count: 1 !important;
		transition-duration: 0.001ms !important;
		scroll-behavior: auto !important;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto !important;
		}
	}

	/* Cores forçadas (Alto contraste do Windows): bordas visíveis nos cartões. */
	@media (forced-colors: active) {
		.ambient {
			display: none;
		}
		:where(a, button, input, summary, [tabindex]):focus-visible {
			outline: 3px solid CanvasText;
		}
	}

	body {
		margin: 0;
		padding: 0;
		background-color: var(--abismo-profundo);
		color: var(--texto-principal);
		font-family: var(--font-body);
		min-height: 100vh;
		overflow-x: hidden;
		overflow-wrap: break-word;
	}

	/* O fundo radial original */
	.ambient {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(
				ellipse 60% 45% at 18% 12%,
				rgb(var(--rgb-ceu) / 0.18),
				transparent 60%
			),
			radial-gradient(
				ellipse 70% 55% at 82% 100%,
				rgb(var(--rgb-cobalto) / 0.22),
				transparent 65%
			),
			var(--abismo-profundo);
	}

	/* Renderização da Malha de Grade (Grid) */
	.ambient::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(var(--grid-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
		background-size: 56px 56px;
		mask-image: radial-gradient(
			ellipse 70% 70% at 50% 30%,
			black 30%,
			transparent 85%
		);
		-webkit-mask-image: radial-gradient(
			ellipse 70% 70% at 50% 30%,
			black 30%,
			transparent 85%
		);
	}

</style>

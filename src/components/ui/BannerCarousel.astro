---
// Carrossel de banners do hub (cursos e eventos). Sem rotação automática (WCAG 2.2.2):
// a pessoa troca o banner pelos botões, pelos pontos, pelas setas do teclado ou
// arrastando. Sem JavaScript continua funcionando como uma faixa com rolagem.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Slide {
  title: string;
  url: string;
  banner: { src: ImageMetadata; alt: string };
}

interface Props {
  /** Nome da região para leitores de tela, como "Banners dos cursos". */
  label: string;
  slides: Slide[];
}

const { label, slides } = Astro.props;
const total = slides.length;
// Com muitos banners os pontos não cabem no celular (44 px cada): vira um contador.
const comPontos = total <= 5;
---

{total > 0 && (
  <section class="carrossel" aria-roledescription="carrossel" aria-label={label} data-carrossel>
    <div class="carrossel-trilho" data-trilho>
      {slides.map((slide, i) => (
        <div
          class="carrossel-slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} de ${total}: ${slide.title}`}
          data-slide
        >
          <a href={slide.url} target="_blank" rel="noopener noreferrer" class="carrossel-link">
            <Image
              src={slide.banner.src}
              alt={slide.banner.alt}
              widths={[640, 960, 1584]}
              sizes="(max-width: 992px) calc(100vw - 32px), 960px"
              loading={i === 0 ? "eager" : "lazy"}
              class="carrossel-imagem"
            />
            <span class="sr-only"> (abre em nova aba)</span>
          </a>
        </div>
      ))}
    </div>

    {total > 1 && (
      <div class="carrossel-controles" data-controles hidden>
        <button type="button" class="carrossel-seta" data-anterior aria-label="Banner anterior">
          <span aria-hidden="true">‹</span>
        </button>
        {comPontos ? (
        <div class="carrossel-pontos">
          {slides.map((slide, i) => (
            <button
              type="button"
              class="carrossel-ponto"
              data-ponto={i}
              aria-label={`Mostrar banner ${i + 1}: ${slide.title}`}
              aria-current={i === 0 ? "true" : undefined}
            />
          ))}
        </div>
        ) : (
          <span class="carrossel-contador" aria-hidden="true" data-contador>1 de {total}</span>
        )}
        <button type="button" class="carrossel-seta" data-proximo aria-label="Próximo banner">
          <span aria-hidden="true">›</span>
        </button>
      </div>
    )}
    <p class="sr-only" aria-live="polite" data-anuncio></p>
  </section>
)}

<script>
  function iniciarCarrossel(raiz: HTMLElement) {
    const trilho = raiz.querySelector<HTMLElement>("[data-trilho]")!;
    const slides = [...raiz.querySelectorAll<HTMLElement>("[data-slide]")];
    const pontos = [...raiz.querySelectorAll<HTMLButtonElement>("[data-ponto]")];
    const status = raiz.querySelector<HTMLElement>("[data-anuncio]")!;
    const contador = raiz.querySelector<HTMLElement>("[data-contador]");
    const controles = raiz.querySelector<HTMLElement>("[data-controles]");
    if (!controles || slides.length < 2) return;
    controles.hidden = false;

    const semMovimento = () =>
      document.documentElement.classList.contains("a11y-sem-movimento") ||
      matchMedia("(prefers-reduced-motion: reduce)").matches;
    let atual = 0;

    const marcar = (i: number) => {
      atual = i;
      if (contador) contador.textContent = `${i + 1} de ${slides.length}`;
      pontos.forEach((p, j) => (j === i ? p.setAttribute("aria-current", "true") : p.removeAttribute("aria-current")));
    };

    const ir = (i: number) => {
      const destino = (i + slides.length) % slides.length;
      trilho.scrollTo({ left: slides[destino].offsetLeft - trilho.offsetLeft, behavior: semMovimento() ? "auto" : "smooth" });
      marcar(destino);
      status.textContent = slides[destino].getAttribute("aria-label") ?? "";
    };

    raiz.querySelector("[data-anterior]")!.addEventListener("click", () => ir(atual - 1));
    raiz.querySelector("[data-proximo]")!.addEventListener("click", () => ir(atual + 1));
    pontos.forEach((p, i) => p.addEventListener("click", () => ir(i)));

    raiz.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") ir(atual - 1);
      else if (e.key === "ArrowRight") ir(atual + 1);
      else return;
      e.preventDefault();
    });

    // Arrastar ou rolar (inclusive pelo Tab entre os links) também atualiza os pontos.
    let espera = 0;
    trilho.addEventListener("scroll", () => {
      clearTimeout(espera);
      // clientWidth é 0 enquanto o carrossel está numa aba escondida
      if (trilho.clientWidth) espera = window.setTimeout(() => marcar(Math.round(trilho.scrollLeft / trilho.clientWidth)), 80);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-carrossel]").forEach(iniciarCarrossel);
</script>

<style>
  .carrossel {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .carrossel-trilho {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    border-radius: 8px;
    border: 1px solid var(--hairline);
  }

  .carrossel-trilho::-webkit-scrollbar {
    display: none;
  }

  /* position: relative prende o .sr-only (absoluto) dentro do slide; sem isso, o
     texto dos slides fora da tela estica a página e cria rolagem horizontal. */
  .carrossel-slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .carrossel-link {
    display: block;
    border-radius: 8px;
  }

  .carrossel-imagem {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1584 / 396;
  }

  .carrossel-controles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .carrossel-controles[hidden] {
    display: none;
  }

  /* Alvos de toque de 44px (WCAG 2.5.5) */
  .carrossel-seta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--hairline-strong);
    border-radius: 50%;
    background: rgb(var(--rgb-cartao) / 0.6);
    color: var(--texto-principal);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .carrossel-seta:hover {
    border-color: var(--nucleo-eletrico);
    color: var(--nucleo-eletrico);
  }

  .carrossel-contador {
    min-width: 72px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--texto-secundario);
  }

  .carrossel-pontos {
    display: flex;
  }

  .carrossel-ponto {
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    cursor: pointer;
    position: relative;
  }

  .carrossel-ponto::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 2px solid var(--texto-secundario);
  }

  .carrossel-ponto[aria-current="true"]::after {
    width: 28px;
    border-radius: 6px;
    border-color: var(--nucleo-eletrico);
    background: var(--nucleo-eletrico);
  }

  @media (prefers-reduced-motion: reduce) {
    .carrossel-trilho {
      scroll-behavior: auto;
    }
  }

  :global(.a11y-sem-movimento) .carrossel-trilho {
    scroll-behavior: auto;
  }
</style>

---
interface Props {
  content: string;
}
const { content } = Astro.props;
---

<div class="urgency-bar" role="status" aria-label="Resumo do programa">
  <span class="live-dot" aria-hidden="true"></span>
  <Fragment set:html={content} />
</div>

<style>
  .urgency-bar {
    position: relative;
    z-index: 50;
    /* Gradiente animado utilizando as cores da identidade visual */
    background: linear-gradient(90deg, #1a3ac8, #00b8b8 50%, #1a3ac8);
    background-size: 200% 100%;
    animation: shimmer 8s linear infinite;
    color: #fff;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 9px 16px;
    text-align: center;
  }

  @keyframes shimmer {
    to {
      background-position: -200% 0;
    }
  }

  .urgency-bar strong {
    /* Referência à variável global definida no root do projeto */
    color: var(--nucleo-eletrico);
    font-weight: 600;
  }

  .urgency-bar .live-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--nucleo-eletrico);
    margin-right: 8px;
    vertical-align: 1px;
    box-shadow: 0 0 10px var(--nucleo-eletrico);
    animation: pulse 1.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.7);
    }
  }
</style>

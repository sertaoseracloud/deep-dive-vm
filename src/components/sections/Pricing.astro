---
import Button from "../ui/Button.astro";
import SectionHead from "../ui/SectionHead.astro";

interface PricingProps {
  eyebrow: string;
  titleHtml: string;
  lede: string;
  ribbon: string;
  tierLabel: string;
  courseName: string;
  originalPrice: string;
  installments: { count: number; value: string; cents: string };
  pixPrice: string;
  pixNote?: string;
  includes: Array<{ html: string; delay?: number }>;
  ctaHref: string;
  ctaText: string;
  guarantee: { days: number; heading: string; body: string };
}

const {
  eyebrow, titleHtml, lede, ribbon, tierLabel, courseName,
  originalPrice, installments, pixPrice, pixNote, includes,
  ctaHref, ctaText, guarantee,
} = Astro.props;
---

<section class="pricing" id="investimento" data-reveal>
    <div class="container">
        <SectionHead
            center={true}
            eyebrow={eyebrow}
            titleHtml={titleHtml}
            lede={lede}
        />

        <div class="price-card">
            <div class="price-ribbon">
                {ribbon}
            </div>
            <div class="price-body">
                <div class="price-tier">{tierLabel}</div>
                <h3 class="price-name">{courseName}</h3>

                <div class="price-anchor">
                    <span class="total">DE <s>{originalPrice}</s> · POR</span>
                </div>

                <div class="price-display">
                    <span class="x">{installments.count}×</span>
                    <span class="currency">R$</span>
                    <span class="num">{installments.value}</span>
                    <span class="cents">{installments.cents}</span>
                </div>
                <div class="price-or">
                    OU <b>{pixPrice}</b> à vista no PIX · {pixNote ?? "sem juros, sem pegadinha."}
                </div>

                <ul class="price-includes">
                    {includes.map((item, i) => (
                        <li data-stagger style={`animation-delay: ${item.delay ?? i * 80}ms`}>
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                            >
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span set:html={item.html} />
                        </li>
                    ))}
                </ul>
                <Button
                    href={ctaHref}
                    variant="primary"
                    size="massive"
                    customClass="price-cta"
                >
                    {ctaText}
                    <span class="arrow">
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M5 12h14M13 5l7 7-7 7"></path>
                        </svg>
                    </span>
                </Button>
                <div class="price-secure">
                    <span
                        ><svg
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            ><rect x="3" y="11" width="18" height="11" rx="2"
                            ></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"
                            ></path></svg
                        >HOTMART · COMPRA SEGURA</span
                    >
                    <span
                        ><svg
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            ><rect x="2" y="5" width="20" height="14" rx="2"
                            ></rect><line x1="2" y1="10" x2="22" y2="10"
                            ></line></svg
                        >CARTÃO · PIX · BOLETO</span
                    >
                    <span
                        ><svg
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            ><path d="M12 2L3 7l9 5 9-5-9-5zM3 17l9 5 9-5"
                            ></path></svg
                        >ACESSO IMEDIATO</span
                    >
                </div>
            </div>
        </div>

        <div class="guarantee">
            <div class="guarantee-seal">
                <span class="big">{guarantee.days}</span>
                <span class="small">DIAS</span>
            </div>
            <div>
                <h3>{guarantee.heading}</h3>
                <p set:html={guarantee.body} />
            </div>
        </div>
    </div>
</section>

<style>
    .pricing {
        background:
            radial-gradient(
                ellipse 50% 30% at 50% 0%,
                rgba(0, 255, 255, 0.1),
                transparent 70%
            ),
            linear-gradient(
                180deg,
                rgba(10, 15, 30, 0.7),
                rgba(27, 41, 60, 0.55)
            );
        border-top: 1px solid var(--hairline-strong);
        border-bottom: 1px solid var(--hairline-strong);
    }

    .price-card {
        max-width: 640px;
        margin: 0 auto;
        border: 1px solid var(--hairline-strong);
        background: rgba(10, 15, 30, 0.85);
        border-radius: 2px;
        overflow: hidden;
        position: relative;
        box-shadow:
            var(--shadow-card),
            0 0 60px rgba(0, 255, 255, 0.15);
        transition: transform 0.15s var(--ease-micro), box-shadow 0.15s var(--ease-micro);
    }

    .price-card:hover {
        will-change: transform;
        transform: translateY(-6px) scale(1.01);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 0 1px var(--nucleo-eletrico);
    }

    .price-card:focus-within {
        outline: 2px solid var(--nucleo-eletrico);
        outline-offset: 4px;
    }

    @media (prefers-reduced-motion: reduce) {
        .price-card {
            transition: box-shadow 0.15s var(--ease-micro);
            will-change: auto;
        }
        .price-card:hover {
            will-change: auto;
            transform: none;
            box-shadow: 0 0 0 2px var(--nucleo-eletrico);
        }
    }

    .price-ribbon {
        background: linear-gradient(
            90deg,
            var(--chama-primaria),
            var(--nucleo-eletrico) 80%
        );
        color: #fff;
        text-align: center;
        padding: 12px 16px;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        font-weight: 500;
    }

    .price-body {
        padding: 40px 40px 32px;
    }

    @media (max-width: 560px) {
        .price-body {
            padding: 32px 24px 24px;
        }
    }

    .price-tier {
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--nucleo-eletrico);
        margin-bottom: 12px;
    }

    .price-name {
        font-family: "Chakra Petch", sans-serif;
        font-weight: 600;
        font-size: 28px;
        line-height: 1.15;
        margin: 0 0 24px;
    }

    .price-anchor {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 14px;
    }

    .price-anchor .total {
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        color: var(--texto-secundario);
    }

    .price-display {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 8px;
        font-family: "Chakra Petch", sans-serif;
    }

    .price-display .x {
        font-size: 22px;
        font-weight: 500;
        color: var(--texto-secundario);
    }
    .price-display .currency {
        font-size: 24px;
        color: var(--texto-secundario);
        font-weight: 500;
    }
    .price-display .num {
        font-size: 72px;
        font-weight: 700;
        color: var(--texto-principal);
        line-height: 0.9;
        letter-spacing: -0.01em;
        text-shadow: 0 0 24px rgba(0, 255, 255, 0.25);
    }
    .price-display .cents {
        font-size: 28px;
        font-weight: 600;
        color: var(--texto-principal);
    }

    .price-or {
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        color: var(--texto-secundario);
        margin: 4px 0 28px;
        letter-spacing: 0.04em;
    }

    .price-or b {
        color: var(--nucleo-eletrico);
        font-weight: 500;
    }

    .price-includes {
        list-style: none;
        padding: 0;
        margin: 0 0 28px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .price-includes li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 14px;
        color: var(--texto-secundario);
        line-height: 1.45;
    }

    .price-includes li svg {
        color: var(--nucleo-eletrico);
        flex-shrink: 0;
        margin-top: 2px;
        filter: drop-shadow(0 0 4px rgba(0, 255, 255, 0.5));
    }

    .price-includes li b {
        color: var(--texto-principal);
        font-weight: 500;
    }

    .price-secure {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        margin-top: 18px;
        flex-wrap: wrap;
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--texto-secundario);
    }

    .price-secure span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .price-secure svg {
        color: var(--nucleo-eletrico);
    }

    /* Guarantee Seal */
    .guarantee {
        max-width: 720px;
        margin: 40px auto 0;
        border: 1px dashed var(--hairline-strong);
        padding: 28px 32px;
        display: grid;
        grid-template-columns: 90px 1fr;
        gap: 24px;
        align-items: center;
        background: rgba(10, 15, 30, 0.5);
    }

    @media (max-width: 560px) {
        .guarantee {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 24px;
        }
        .guarantee-seal {
            margin: 0 auto;
        }
    }

    .guarantee-seal {
        width: 90px;
        height: 90px;
        border: 2px solid var(--nucleo-eletrico);
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--nucleo-eletrico);
        font-family: "Chakra Petch", sans-serif;
        box-shadow: var(--glow-cyan);
        background: rgba(0, 255, 255, 0.05);
    }

    .guarantee-seal .big {
        font-size: 30px;
        font-weight: 700;
        line-height: 1;
    }
    .guarantee-seal .small {
        font-size: 9px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        margin-top: 4px;
    }

    .guarantee h3 {
        font-family: "Chakra Petch", sans-serif;
        font-weight: 600;
        font-size: 20px;
        margin: 0 0 8px;
        color: var(--texto-principal);
    }
    .guarantee p {
        margin: 0;
        color: var(--texto-secundario);
        font-size: 14px;
        line-height: 1.55;
    }
</style>

---
import SectionHead from "../ui/SectionHead.astro";

interface PainCard {
    num: string;
    titleHtml: string;
    body: string;
}

interface PainPointsProps {
    eyebrow: string;
    titleHtml: string;
    lede: string;
    cards: PainCard[];
}

const { eyebrow, titleHtml, lede, cards } = Astro.props;
---

<section class="pain" id="pain" data-reveal>
    <div class="container">
        <SectionHead
            eyebrow={eyebrow}
            titleHtml={titleHtml}
            lede={lede}
        />

        <div class="pain-grid">
            {cards.map(card => (
                <div class="pain-card">
                    <span class="num">{card.num}</span>
                    <h3 set:html={card.titleHtml} />
                    <p set:html={card.body} />
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .pain {
        background: linear-gradient(
            180deg,
            transparent,
            rgb(var(--rgb-fundo) / 0.6) 30%,
            rgb(var(--rgb-fundo) / 0.6) 70%,
            transparent
        );
    }

    .pain-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    @media (max-width: 720px) {
        .pain-grid {
            grid-template-columns: 1fr;
        }
    }

    .pain-card {
        border: 1px solid var(--hairline);
        background: rgb(var(--rgb-cartao) / 0.35);
        padding: 28px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        border-radius: 2px;
        position: relative;
        overflow: hidden;
    }

    .pain-card::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(
            180deg,
            transparent,
            rgb(var(--rgb-perigo) / 0.5),
            transparent
        );
    }

    .pain-card .num {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.2em;
        color: var(--perigo-texto);
    }

    .pain-card h3 {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.1875rem;
        margin: 0;
        color: var(--texto-principal);
        line-height: 1.25;
    }

    .pain-card p {
        margin: 0;
        color: var(--texto-secundario);
        font-size: 0.875rem;
    }
</style>

---
import Button from "../ui/Button.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface HeroProps {
  eyebrowTag: string;
  eyebrowDesc: string;
  titleHtml: string;
  sub: string;
  points: Array<{ html: string }>;
  ctaPrimary: { href: string; label: string };
  ctaGhost: { href: string; label: string };
  metaBadges: Array<{ icon: string; label: string }>;
  portrait: { src: ImageMetadata; alt: string };
  portraitStats: Array<{ label: string }>;
  portraitTag: { name: string; badge: string };
}

const {
  eyebrowTag, eyebrowDesc, titleHtml, sub, points,
  ctaPrimary, ctaGhost, metaBadges, portrait, portraitStats, portraitTag,
} = Astro.props;
---

<header id="top" class="hero">
    <div class="container hero-grid">
        <div class="hero-content">
            <div class="eyebrow">
                <span class="bar"></span>
                <span class="idx">{eyebrowTag}</span>
                <span>{eyebrowDesc}</span>
            </div>

            <h1 class="hero-title" set:html={titleHtml} />

            <p class="hero-sub" set:html={sub} />

            <ul class="hero-points">
                {points.map(point => (
                    <li>
                        <svg
                            aria-hidden="true"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span set:html={point.html} />
                    </li>
                ))}
            </ul>

            <div class="hero-cta-row">
                <Button href={ctaPrimary.href} variant="primary" size="massive" testid="hero-cta-primary">
                    {ctaPrimary.label}
                    <span class="arrow">
                        <svg
                            aria-hidden="true"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M5 12h14M13 5l7 7-7 7"></path>
                        </svg>
                    </span>
                </Button>
                <Button href={ctaGhost.href} variant="ghost" testid="hero-cta-ghost">
                    <svg
                        aria-hidden="true"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        style="margin-right: 8px;"
                    >
                        <path
                            d="M12 2l2.09 6.26H20l-4.95 3.64L16.9 18 12 14.27 7.1 18l1.85-6.1L4 8.26h5.91z"
                        ></path>
                    </svg>
                    {ctaGhost.label}
                </Button>
            </div>

            <div class="hero-meta">
                {metaBadges.map(badge => (
                    <span>
                        <Fragment set:html={badge.icon} />
                        {badge.label}
                    </span>
                ))}
            </div>
        </div>

        <div class="hero-portrait-wrap">
            <Image
                src={portrait.src}
                alt={portrait.alt}
                loading="eager"
                fetchpriority="high"
            />
            <div class="brackets">
                <span></span><span></span><span></span><span></span>
            </div>
            <div class="portrait-stats">
                {portraitStats.map(stat => (
                    <div class="portrait-stat">{stat.label}</div>
                ))}
            </div>
            <div class="portrait-tag">
                <span class="name">{portraitTag.name}</span>
                <div class="badges">
                    <span class="b">{portraitTag.badge}</span>
                </div>
            </div>
        </div>
    </div>
</header>

<style>
    /* CSS fallback: garante visibilidade do conteúdo antes da hidratação React */
    .hero-content {
        opacity: 1;
    }

    /* Sobrescreve opacity:0 do motion.div (initial) antes da hidratação do HeroMotion.
       A regra :global garante que o Astro não faça scoping nesta seleção.
       Quando motion.js hidrata, aplica inline style com maior especificidade,
       então a animação funciona normalmente após hidratação. */
    :global(astro-island .hero-content) {
        opacity: 1 !important;
    }

    .hero {
        padding: 80px 0 80px;
        position: relative;
        overflow: hidden;
    }

    .hero::before {
        content: "";
        position: absolute;
        top: -80px;
        right: -120px;
        width: 700px;
        height: 700px;
        background: radial-gradient(
            circle at 50% 50%,
            rgba(0, 255, 255, 0.25),
            transparent 60%
        );
        filter: blur(12px);
        pointer-events: none;
        z-index: 0;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: 64px;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    @media (max-width: 980px) {
        .hero-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }
    }

    /* Eyebrow específico do Hero */
    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--nucleo-eletrico);
        margin-bottom: 16px;
    }

    .eyebrow .bar {
        width: 28px;
        height: 1px;
        background: currentColor;
        opacity: 0.5;
    }

    .eyebrow .idx {
        border: 1px solid var(--hairline-strong);
        padding: 3px 8px;
        background: rgba(0, 255, 255, 0.06);
        font-size: 10px;
    }

    .hero-title {
        font-family: "Chakra Petch", sans-serif;
        font-weight: 600;
        font-size: clamp(26px, 3vw, 42px);
        line-height: 1.05;
        letter-spacing: -0.012em;
        margin: 0 0 16px;
        text-wrap: balance;
    }

    .hero-title :global(.flame) {
        color: var(--nucleo-eletrico);
        font-style: italic;
        text-shadow:
            0 0 32px rgba(0, 255, 255, 0.6),
            0 0 80px rgba(0, 255, 255, 0.25);
    }

    .hero-title :global(.crossed) {
        text-decoration: line-through;
        text-decoration-color: rgba(255, 90, 90, 0.7);
        color: var(--texto-terciario);
        font-style: normal;
    }

    .hero-sub {
        font-size: 14px;
        line-height: 1.55;
        color: var(--texto-secundario);
        max-width: 56ch;
        font-weight: 300;
        margin: 0 0 22px;
    }

    .hero-sub strong {
        color: var(--texto-principal);
        font-weight: 500;
    }

    .hero-points {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 0 0 28px;
        list-style: none;
        padding: 0;
    }

    .hero-points li {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 12.5px;
        color: var(--texto-secundario);
    }

    .hero-points li svg {
        flex-shrink: 0;
        color: var(--nucleo-eletrico);
        margin-top: 2px;
        filter: drop-shadow(0 0 6px rgba(0, 255, 255, 0.6));
    }

    .hero-cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: center;
        margin-bottom: 28px;
    }

    .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--texto-secundario);
        padding-top: 24px;
        border-top: 1px dashed var(--hairline);
    }

    .hero-meta span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .hero-meta svg {
        color: var(--nucleo-eletrico);
    }

    /* Hero portrait wrap (Exactamente igual ao index.html) */
    .hero-portrait-wrap {
        position: relative;
        aspect-ratio: 4/5;
        max-width: 480px;
        margin-left: auto;
        border: 1px solid var(--hairline-strong);
        background: var(--neutro-escuro);
        overflow: hidden;
    }

    .hero-portrait-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(1.1) contrast(1.05);
        position: relative;
        z-index: 1;
    }

    .hero-portrait-wrap::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
            linear-gradient(
                180deg,
                rgba(10, 15, 30, 0) 50%,
                rgba(10, 15, 30, 0.8) 100%
            ),
            repeating-linear-gradient(
                to bottom,
                transparent 0,
                transparent 3px,
                rgba(0, 0, 0, 0.18) 3px,
                rgba(0, 0, 0, 0.18) 4px
            );
        pointer-events: none;
        z-index: 2;
    }

    .brackets {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 3;
    }

    .brackets span {
        position: absolute;
        width: 24px;
        height: 24px;
        border-color: var(--nucleo-eletrico);
        border-style: solid;
        filter: drop-shadow(0 0 8px rgba(0, 255, 255, 0.7));
    }

    .brackets span:nth-child(1) {
        top: -1px;
        left: -1px;
        border-width: 2px 0 0 2px;
    }
    .brackets span:nth-child(2) {
        top: -1px;
        right: -1px;
        border-width: 2px 2px 0 0;
    }
    .brackets span:nth-child(3) {
        bottom: -1px;
        left: -1px;
        border-width: 0 0 2px 2px;
    }
    .brackets span:nth-child(4) {
        bottom: -1px;
        right: -1px;
        border-width: 0 2px 2px 0;
    }

    .portrait-tag {
        position: absolute;
        left: 16px;
        bottom: 16px;
        z-index: 4;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .portrait-tag .name {
        font-family: "Chakra Petch", sans-serif;
        font-weight: 600;
        font-size: 16px;
        color: #fff;
    }

    .portrait-tag .badges {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .portrait-tag .b {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: "JetBrains Mono", monospace;
        font-size: 9px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        padding: 4px 8px;
        background: rgba(0, 255, 255, 0.08);
        border: 1px solid var(--hairline-strong);
        color: var(--nucleo-eletrico);
    }

    .portrait-stats {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 4;
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-end;
    }

    .portrait-stat {
        background: rgba(10, 15, 30, 0.78);
        border: 1px solid var(--hairline);
        backdrop-filter: blur(8px);
        padding: 8px 12px;
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--texto-secundario);
    }

    .portrait-stat b {
        color: var(--nucleo-eletrico);
        font-weight: 500;
    }
</style>

---
import SectionHead from "../ui/SectionHead.astro";

interface Bonus {
    num: string;
    featured?: boolean;
    originalPrice?: string;
    title: string;
    bodyHtml: string;
    delay?: number;
}

interface BonusesProps {
    eyebrow: string;
    titleHtml: string;
    lede: string;
    bonuses: Bonus[];
}

const { eyebrow, titleHtml, lede, bonuses } = Astro.props;
---

<section class="bonuses" id="bonus" data-reveal>
    <div class="container">
        <SectionHead
            center={true}
            eyebrow={eyebrow}
            titleHtml={titleHtml}
            lede={lede}
        />

        <div class="bonus-grid">
            {bonuses.map((bonus, i) => (
                <div class={`bonus-card${bonus.featured ? ' featured' : ''}`} data-stagger style={`animation-delay: ${bonus.delay ?? i * 80}ms`}>
                    <div class="bonus-num">
                        <span>{bonus.num}</span>
                        {bonus.originalPrice && <span class="price"><s>{bonus.originalPrice}</s> GRÁTIS</span>}
                    </div>
                    <h3>{bonus.title}</h3>
                    <p set:html={bonus.bodyHtml} />
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .bonuses {
        background: linear-gradient(
            180deg,
            rgba(10, 15, 30, 0),
            rgba(27, 41, 60, 0.45) 40%
        );
    }

    .bonus-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    @media (max-width: 880px) {
        .bonus-grid {
            grid-template-columns: 1fr;
        }
    }

    .bonus-card {
        border: 1px solid var(--hairline);
        background: rgba(10, 15, 30, 0.55);
        padding: 28px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        position: relative;
        overflow: hidden;
        border-radius: 2px;
    }

    /* Efeito de brilho radial no topo direito */
    .bonus-card::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 80px;
        height: 80px;
        background: radial-gradient(
            circle at 100% 0%,
            rgba(0, 255, 255, 0.15),
            transparent 70%
        );
        pointer-events: none;
    }

    /* Estilo específico para o bônus em destaque (Mentoria 1:1) */
    .bonus-card.featured {
        border-color: var(--hairline-strong);
        background: linear-gradient(
            180deg,
            rgba(0, 255, 255, 0.05),
            rgba(10, 15, 30, 0.55)
        );
    }

    .bonus-num {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--nucleo-eletrico);
    }

    .bonus-num .price {
        font-family: "Space Grotesk", sans-serif;
        color: var(--texto-principal);
        font-weight: 500;
        text-transform: none;
        letter-spacing: 0.02em;
    }

    .bonus-num .price s {
        color: var(--texto-terciario);
        margin-right: 6px;
        font-weight: 300;
    }

    .bonus-card h3 {
        font-family: "Chakra Petch", sans-serif;
        font-weight: 600;
        font-size: 20px;
        margin: 0;
        line-height: 1.2;
        color: var(--texto-principal);
    }

    .bonus-card p {
        margin: 0;
        color: var(--texto-secundario);
        font-size: 14px;
        line-height: 1.55;
    }
</style>

---
/* Componente TrustBand - Versão Blindada para Visibilidade Total */
---

<div class="trust">
    <div class="container trust-row">
        <div class="trust-label">
            PROFISSIONAIS<br />DE EMPRESAS COMO
        </div>

        <div class="trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path
                    d="M11 11H2V2h9v9zM22 11h-9V2h9v9zM11 22H2v-9h9v9zM22 22h-9v-9h9v9z"
                ></path>
            </svg>
            ENTERPRISE
        </div>

        <div class="trust-item">
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
            >
                <path d="M4 17l6-6 4 4 6-6M14 7h6v6"></path>
            </svg>
            FINTECH
        </div>

        <div class="trust-item">
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M3 9l9-6 9 6v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
            </svg>
            SAAS B2B
        </div>

        <div class="trust-item">
            <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="4"></circle>
            </svg>
            CONSULTORIAS
        </div>
    </div>
</div>

<style>
    .trust {
        padding: 32px 0;
        border-top: 1px solid rgba(209, 217, 230, 0.12);
        border-bottom: 1px solid rgba(209, 217, 230, 0.12);
        background: rgba(
            10,
            15,
            30,
            0.8
        ); /* Fundo mais opaco para garantir contraste */
        position: relative;
        z-index: 10;
        width: 100%;
    }

    .trust-row {
        display: grid;
        grid-template-columns: auto repeat(4, 1fr);
        gap: 32px;
        align-items: center;
    }

    .trust-label {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        line-height: 1.4;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #d1d9e6; /* Cor fixa caso a variável falhe */
        min-width: 140px;
    }

    .trust-item {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: "Chakra Petch", sans-serif;
        font-size: 14px;
        letter-spacing: 0.06em;
        color: #ffffff; /* Texto em branco puro */
        text-transform: uppercase;
        font-weight: 500;
        white-space: nowrap;
    }

    .trust-item svg {
        color: #00ffff; /* Ciano fixo */
        filter: drop-shadow(0 0 6px rgba(0, 255, 255, 0.5));
        flex-shrink: 0;
    }

    /* Responsividade exata do index.html */
    @media (max-width: 880px) {
        .trust-row {
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }
        .trust-label {
            grid-column: span 2;
            text-align: center;
            margin-bottom: 8px;
        }
        .trust-item {
            justify-content: center;
        }
    }

    @media (max-width: 480px) {
        .trust-row {
            grid-template-columns: 1fr;
            gap: 16px;
        }
        .trust-label {
            grid-column: span 1;
        }
    }
</style>

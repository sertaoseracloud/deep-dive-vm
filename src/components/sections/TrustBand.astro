---
interface TrustBandProps {
    label: string;
    items: Array<{ svgHtml: string; label: string }>;
}

const { label, items } = Astro.props;
---

<div class="trust">
    <div class="container trust-row">
        <div class="trust-label" set:html={label.replace('\n', '<br />')} />
        {items.map(item => (
            <div class="trust-item">
                <Fragment set:html={item.svgHtml} />
                {item.label}
            </div>
        ))}
    </div>
</div>

<style>
    .trust {
        padding: 32px 0;
        border-top: 1px solid rgba(209, 217, 230, 0.12);
        border-bottom: 1px solid rgba(209, 217, 230, 0.12);
        background: rgba(
            10,
            15,
            30,
            0.8
        ); /* Fundo mais opaco para garantir contraste */
        position: relative;
        z-index: 10;
        width: 100%;
    }

    .trust-row {
        display: grid;
        grid-template-columns: auto repeat(4, 1fr);
        gap: 32px;
        align-items: center;
    }

    .trust-label {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        line-height: 1.4;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #d1d9e6; /* Cor fixa caso a variável falhe */
        min-width: 140px;
    }

    .trust-item {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: "Chakra Petch", sans-serif;
        font-size: 14px;
        letter-spacing: 0.06em;
        color: #ffffff; /* Texto em branco puro */
        text-transform: uppercase;
        font-weight: 500;
        white-space: nowrap;
    }

    .trust-item svg {
        color: #00ffff; /* Ciano fixo */
        filter: drop-shadow(0 0 6px rgba(0, 255, 255, 0.5));
        flex-shrink: 0;
    }

    /* Responsividade exata do index.html */
    @media (max-width: 880px) {
        .trust-row {
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }
        .trust-label {
            grid-column: span 2;
            text-align: center;
            margin-bottom: 8px;
        }
        .trust-item {
            justify-content: center;
        }
    }

    @media (max-width: 480px) {
        .trust-row {
            grid-template-columns: 1fr;
            gap: 16px;
        }
        .trust-label {
            grid-column: span 1;
        }
    }
</style>

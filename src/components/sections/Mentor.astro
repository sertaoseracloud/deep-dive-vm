---
import SectionHead from "../ui/SectionHead.astro";
import claudio2 from "../../assets/claudio2.png";
import marcelo from "../../assets/marcelo.png";
---

<section class="mentor" id="mentor">
    <div class="container">
        <div class="mentor-grid">
            <div class="mentor-portrait">
                <img src={claudio2.src} alt="Cláudio Filipe Lima Raposo" />
                <div class="brackets">
                    <span></span><span></span><span></span><span></span>
                </div>
            </div>
            <div>
                <SectionHead
                    eyebrow="O MENTOR"
                    titleHtml="Cláudio Filipe Lima Raposo"
                />
                <div class="mentor-name">
                    ⟡ SYSTEMS ARCHITECT · 2× MVP · DOCKER CAPTAIN · GREEN SW
                    CHAMPION
                </div>
                <p class="mentor-bio">
                    <strong>Systems Architect </strong> e <strong
                        >DBA Student no MUST-USA</strong
                    >. Reconhecido pela Microsoft com <strong
                        >2 anos de MVP Award</strong
                    >, pela Docker com <strong>2 anos de Captain</strong> e como
                    <strong>Green Software Champion</strong> · além de <strong
                        >10× certificado Microsoft e 7× AWS</strong
                    >.
                </p>
                <p class="mentor-bio">
                    Stack políglota · <strong
                        >GoLang, Java, .NET e Python</strong
                    > · atravessando Azure, AWS e operando arquiteturas em escala
                    corporativa. Já guiou centenas de engenheiros na transição para
                    Arquiteto de Nuvem com <strong>sessões cirúrgicas</strong> que
                    ligam detalhe técnico (UEFI, Encryption at Host, Spot VMs) à decisão
                    estratégica (custo, risco, time-to-market).
                </p>
                <div class="mentor-credentials">
                    <div class="credential">
                        <div class="v">2×</div>
                        <div class="l">MICROSOFT<br />MVP AWARD</div>
                    </div>
                    <div class="credential">
                        <div class="v">⚓</div>
                        <div class="l">DOCKER<br />CAPTAIN · 2Y</div>
                    </div>
                    <div class="credential">
                        <div class="v">17×</div>
                        <div class="l">CERTIFICAÇÕES<br />MSFT &amp; AWS</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mentor-divider" aria-hidden="true">
            <span class="line"></span>
            <span class="label">+ PROFESSOR CONVIDADO</span>
            <span class="line"></span>
        </div>

        <div class="mentor-grid reverse">
            <div>
                <SectionHead
                    eyebrow="Cloud in Focus"
                    titleHtml="Marcelo Gonçalves"
                />

                <div class="mentor-name">
                    ⟡ DUAL MVP (INTUNE &amp; AZURE) · DOCKER CAPTAIN · IBM
                    CHAMPION 2026 · MCT
                </div>
                <p class="mentor-bio">
                    Criador do <strong>Cloud in Focus</strong>, referência
                    brasileira em conteúdo prático sobre Azure e operação de
                    nuvem em escala. <strong
                        >Dual Microsoft MVP (Intune &amp; Azure)</strong
                    >, <strong>Docker Captain</strong>, <strong
                        >IBM Champion 2026</strong
                    > e <strong>MCT</strong> (Microsoft Certified Trainer).
                </p>
                <p class="mentor-bio">
                    Atua nos eixos críticos da nuvem moderna: <strong
                        >Intune, Defender, Cybersecurity, SCCM, Azure, GCP, OCI
                        e FinOps</strong
                    >. Marcelo grava conteúdo <strong
                        >lado a lado com o Cláudio dentro dos módulos</strong
                    > · duas vozes, dois ângulos de campo. Onde o Cláudio traz o rigor
                    de arquiteto de sistemas, Marcelo traz o
                    <strong
                        >olhar de quem opera segurança e endpoint em produção</strong
                    >.
                </p>
                <div class="mentor-credentials">
                    <div class="credential">
                        <div class="v">2×</div>
                        <div class="l">
                            MICROSOFT MVP<br />INTUNE &amp; AZURE
                        </div>
                    </div>
                    <div class="credential">
                        <div class="v">IBM</div>
                        <div class="l">CHAMPION<br />2026</div>
                    </div>
                    <div class="credential">
                        <div class="v">MCT</div>
                        <div class="l">DOCKER CAPTAIN<br />+ MCT</div>
                    </div>
                </div>
            </div>
            <div class="mentor-portrait">
                <img
                    src={marcelo.src}
                    alt="Marcelo Gonçalves · Cloud in Focus"
                />
                <div class="brackets">
                    <span></span><span></span><span></span><span></span>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .mentor {
        background:
            radial-gradient(
                ellipse 50% 50% at 80% 50%,
                rgba(0, 255, 255, 0.1),
                transparent 60%
            ),
            linear-gradient(
                180deg,
                rgba(10, 15, 30, 0.6),
                rgba(27, 41, 60, 0.4)
            );
        border-top: 1px solid var(--hairline);
        border-bottom: 1px solid var(--hairline);
    }

    .mentor-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 56px;
        align-items: center;
    }

    .mentor-grid.reverse > .mentor-portrait {
        order: 2;
    }

    @media (max-width: 980px) {
        .mentor-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }
        .mentor-grid.reverse > .mentor-portrait {
            order: 0;
        }
    }

    .mentor-divider {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 80px 0 60px;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.24em;
        color: var(--nucleo-eletrico);
    }

    .mentor-divider .line {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--hairline-strong),
            transparent
        );
    }

    .mentor-divider .label {
        padding: 6px 14px;
        border: 1px solid var(--hairline-strong);
        background: rgba(0, 255, 255, 0.06);
    }

    .mentor-portrait {
        position: relative;
        aspect-ratio: 1;
        max-width: 460px;
        border: 1px solid var(--hairline-strong);
        overflow: hidden;
    }

    .mentor-portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Brackets (Cantoneiras Ciano) */
    .brackets {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 3;
    }

    .brackets span {
        position: absolute;
        width: 24px;
        height: 24px;
        border-color: var(--nucleo-eletrico);
        border-style: solid;
        filter: drop-shadow(0 0 8px rgba(0, 255, 255, 0.7));
    }

    .brackets span:nth-child(1) {
        top: -1px;
        left: -1px;
        border-width: 2px 0 0 2px;
    }
    .brackets span:nth-child(2) {
        top: -1px;
        right: -1px;
        border-width: 2px 2px 0 0;
    }
    .brackets span:nth-child(3) {
        bottom: -1px;
        left: -1px;
        border-width: 0 0 2px 2px;
    }
    .brackets span:nth-child(4) {
        bottom: -1px;
        right: -1px;
        border-width: 0 2px 2px 0;
    }

    .mentor-name {
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--nucleo-eletrico);
        margin-bottom: 16px;
    }

    .mentor-bio {
        color: var(--texto-secundario);
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .mentor-bio strong {
        color: var(--texto-principal);
        font-weight: 500;
    }

    .mentor-credentials {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--hairline);
        border: 1px solid var(--hairline);
        margin-top: 24px;
    }

    @media (max-width: 560px) {
        .mentor-credentials {
            grid-template-columns: 1fr;
        }
    }

    .credential {
        background: rgba(10, 15, 30, 0.7);
        padding: 18px 20px;
    }

    .credential .v {
        font-family: "Chakra Petch", sans-serif;
        font-weight: 700;
        font-size: 28px;
        color: var(--texto-principal);
        margin-bottom: 4px;
        line-height: 1;
    }

    .credential .l {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--texto-secundario);
    }
</style>

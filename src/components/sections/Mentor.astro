---
import SectionHead from "../ui/SectionHead.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface MentorCredential {
    value: string;
    label: string;
}

interface MentorInfo {
    portrait: { src: ImageMetadata; alt: string };
    eyebrow: string;
    /**
     * Mentor's display name. Passed to SectionHead as `titleHtml` and rendered
     * via `set:html`, so HTML entities in the string will be interpreted.
     * Use plain text (no raw HTML) to avoid unintended markup injection.
     */
    name: string;
    tagline: string;
    bioHtml: string[];
    credentials: MentorCredential[];
}

interface MentorProps {
    primary: MentorInfo;
    guest?: MentorInfo;
}

const { primary, guest } = Astro.props;
---

<section class="mentor" id="mentor" data-reveal>
    <div class="container">
        <div class="mentor-grid">
            <div class="mentor-portrait">
                <Image src={primary.portrait.src} alt={primary.portrait.alt} loading="lazy" />
                <div class="brackets">
                    <span></span><span></span><span></span><span></span>
                </div>
            </div>
            <div>
                <SectionHead
                    eyebrow={primary.eyebrow}
                    titleHtml={primary.name}
                />
                <div class="mentor-name">
                    {primary.tagline}
                </div>
                {primary.bioHtml.map(para => (
                    <p class="mentor-bio" set:html={para} />
                ))}
                <div class="mentor-credentials">
                    {primary.credentials.map(cred => (
                        <div class="credential">
                            <div class="v">{cred.value}</div>
                            <div class="l" set:html={cred.label} />
                        </div>
                    ))}
                </div>
            </div>
        </div>

        {guest && (
            <div class="mentor-divider" aria-hidden="true">
                <span class="line"></span>
                <span class="label">+ PROFESSOR CONVIDADO</span>
                <span class="line"></span>
            </div>
        )}

        {guest && (
            <div class="mentor-grid reverse">
                <div>
                    <SectionHead
                        eyebrow={guest.eyebrow}
                        titleHtml={guest.name}
                    />
                    <div class="mentor-name">
                        {guest.tagline}
                    </div>
                    {guest.bioHtml.map(para => (
                        <p class="mentor-bio" set:html={para} />
                    ))}
                    <div class="mentor-credentials">
                        {guest.credentials.map(cred => (
                            <div class="credential">
                                <div class="v">{cred.value}</div>
                                <div class="l" set:html={cred.label} />
                            </div>
                        ))}
                    </div>
                </div>
                <div class="mentor-portrait">
                    <Image
                        src={guest.portrait.src}
                        alt={guest.portrait.alt}
                        loading="lazy"
                    />
                    <div class="brackets">
                        <span></span><span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        )}
    </div>
</section>

<style>
    .mentor {
        background:
            radial-gradient(
                ellipse 50% 50% at 80% 50%,
                rgba(0, 255, 255, 0.1),
                transparent 60%
            ),
            linear-gradient(
                180deg,
                rgba(10, 15, 30, 0.6),
                rgba(27, 41, 60, 0.4)
            );
        border-top: 1px solid var(--hairline);
        border-bottom: 1px solid var(--hairline);
    }

    .mentor-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 56px;
        align-items: center;
    }

    .mentor-grid.reverse > .mentor-portrait {
        order: 2;
    }

    @media (max-width: 980px) {
        .mentor-grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }
        .mentor-grid.reverse > .mentor-portrait {
            order: 0;
        }
    }

    .mentor-divider {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 80px 0 60px;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.24em;
        color: var(--nucleo-eletrico);
    }

    .mentor-divider .line {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--hairline-strong),
            transparent
        );
    }

    .mentor-divider .label {
        padding: 6px 14px;
        border: 1px solid var(--hairline-strong);
        background: rgba(0, 255, 255, 0.06);
    }

    .mentor-portrait {
        position: relative;
        aspect-ratio: 1;
        max-width: 460px;
        border: 1px solid var(--hairline-strong);
        overflow: hidden;
    }

    .mentor-portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Brackets (Cantoneiras Ciano) */
    .brackets {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 3;
    }

    .brackets span {
        position: absolute;
        width: 24px;
        height: 24px;
        border-color: var(--nucleo-eletrico);
        border-style: solid;
        filter: drop-shadow(0 0 8px rgba(0, 255, 255, 0.7));
    }

    .brackets span:nth-child(1) {
        top: -1px;
        left: -1px;
        border-width: 2px 0 0 2px;
    }
    .brackets span:nth-child(2) {
        top: -1px;
        right: -1px;
        border-width: 2px 2px 0 0;
    }
    .brackets span:nth-child(3) {
        bottom: -1px;
        left: -1px;
        border-width: 0 0 2px 2px;
    }
    .brackets span:nth-child(4) {
        bottom: -1px;
        right: -1px;
        border-width: 0 2px 2px 0;
    }

    .mentor-name {
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--nucleo-eletrico);
        margin-bottom: 16px;
    }

    .mentor-bio {
        color: var(--texto-secundario);
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .mentor-bio strong {
        color: var(--texto-principal);
        font-weight: 500;
    }

    .mentor-credentials {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--hairline);
        border: 1px solid var(--hairline);
        margin-top: 24px;
    }

    @media (max-width: 560px) {
        .mentor-credentials {
            grid-template-columns: 1fr;
        }
    }

    .credential {
        background: rgba(10, 15, 30, 0.7);
        padding: 18px 20px;
    }

    .credential .v {
        font-family: "Chakra Petch", sans-serif;
        font-weight: 700;
        font-size: 28px;
        color: var(--texto-principal);
        margin-bottom: 4px;
        line-height: 1;
    }

    .credential .l {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--texto-secundario);
    }
</style>

---
import SectionHead from "../ui/SectionHead.astro";
import ModuleDetails from "../ui/ModuleDetails.astro";

interface CurriculumModule {
    num: string;
    title: string;
    subtitle: string;
    hours: string;
    isOpen?: boolean;
    tracks: Array<{ head: string; body: string }>;
}

interface CurriculumMeta {
    total: string;
    modules: number;
    frentes: number;
    projects: number;
}

interface CurriculumProps {
    eyebrow: string;
    titleHtml: string;
    lede: string;
    meta: CurriculumMeta;
    modules: CurriculumModule[];
}

const { eyebrow, titleHtml, lede, meta, modules } = Astro.props;
---

<section id="ementa" data-reveal>
    <div class="container">
        <SectionHead
            eyebrow={eyebrow}
            titleHtml={titleHtml}
            lede={lede}
        />

        <div class="modules-meta">
            <span><b>{meta.total}</b> CARGA TOTAL</span>
            <div class="sep"></div>
            <span><b>{String(meta.modules).padStart(2, '0')}</b> MÓDULOS</span>
            <div class="sep"></div>
            <span><b>{meta.frentes} FRENTES</b> POR MÓDULO</span>
            <div class="sep"></div>
            <span><b>{meta.projects}</b> BLOCOS PRÁTICOS</span>
        </div>

        {modules.map(m => (
            <ModuleDetails
                num={m.num}
                title={m.title}
                subtitle={m.subtitle}
                hours={m.hours}
                isOpen={m.isOpen ?? false}
                tracks={m.tracks}
            />
        ))}
    </div>
</section>

<style>
    .modules-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        padding: 18px 24px;
        border: 1px solid var(--hairline);
        background: rgba(10, 15, 30, 0.55);
        margin-bottom: 36px;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--texto-secundario);
        align-items: center;
        border-radius: 2px;
    }

    .modules-meta span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .modules-meta b {
        color: var(--nucleo-eletrico);
        font-weight: 500;
    }

    .modules-meta .sep {
        width: 1px;
        height: 14px;
        background: var(--hairline);
    }

    :global(.track) {
        margin-bottom: 24px;
    }

    :global(.track:last-child) {
        margin-bottom: 0;
    }

    :global(.track .head) {
        display: flex;
        align-items: center;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        letter-spacing: 0.15em;
        color: var(--nucleo-eletrico);
        margin-bottom: 8px;
        font-weight: 600;
    }

    :global(.track p) {
        font-size: 14px;
        line-height: 1.6;
        color: var(--texto-secundario);
        margin: 0;
        padding-left: 20px;
        border-left: 1px solid var(--hairline);
    }

    :global(.track code) {
        font-family: "JetBrains Mono", monospace;
        background: rgba(0, 255, 255, 0.05);
        color: var(--nucleo-eletrico);
        padding: 2px 4px;
        font-size: 0.95em;
    }
</style>

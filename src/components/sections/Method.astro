---
import SectionHead from "../ui/SectionHead.astro";

interface MethodStep {
    svgHtml: string;
    label: string;
    title: string;
    bodyHtml: string;
}

interface MethodProps {
    eyebrow: string;
    titleHtml: string;
    lede: string;
    steps: MethodStep[];
}

const { eyebrow, titleHtml, lede, steps } = Astro.props;
---

<section id="metodo" data-reveal>
    <div class="container">
        <SectionHead
            center={true}
            eyebrow={eyebrow}
            titleHtml={titleHtml}
            lede={lede}
        />

        <div class="method-grid">
            {steps.map(step => (
                <div class="method-cell">
                    <div class="icon">
                        <Fragment set:html={step.svgHtml} />
                    </div>
                    <span class="label">{step.label}</span>
                    <h3 set:html={step.title} />
                    <p set:html={step.bodyHtml} />
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .method-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1px;
        background: var(--hairline);
        border: 1px solid var(--hairline);
    }

    @media (max-width: 1180px) {
        .method-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 760px) {
        .method-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 520px) {
        .method-grid {
            grid-template-columns: 1fr;
        }
    }

    .method-cell {
        background: rgba(10, 15, 30, 0.85);
        padding: 28px 26px 32px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        transition: background 0.3s;
        position: relative;
        min-height: 280px;
    }

    .method-cell:hover {
        background: rgba(0, 255, 255, 0.04);
    }

    .method-cell .icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--nucleo-eletrico);
        border: 1px solid var(--hairline-strong);
        background: rgba(0, 255, 255, 0.06);
        filter: drop-shadow(0 0 10px rgba(0, 255, 255, 0.25));
    }

    .method-cell .label {
        font-family: "JetBrains Mono", monospace;
        font-size: 10px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--nucleo-eletrico);
    }

    .method-cell h3 {
        font-family: "Chakra Petch", sans-serif;
        font-weight: 600;
        font-size: 22px;
        margin: 0;
        line-height: 1.15;
        letter-spacing: -0.005em;
    }

    .method-cell p {
        margin: 0;
        font-size: 14px;
        color: var(--texto-secundario);
        line-height: 1.55;
    }
</style>

---
import SectionHead from "../ui/SectionHead.astro";

interface FaqItem {
    question: string;
    answerHtml: string;
}

interface FaqProps {
    eyebrow: string;
    titleHtml: string;
    items: FaqItem[];
}

const { eyebrow, titleHtml, items } = Astro.props;
---

<section id="faq" data-reveal>
    <div class="container">
        <SectionHead
            center={true}
            eyebrow={eyebrow}
            titleHtml={titleHtml}
        />

        <div class="faq">
            {items.map(item => (
                <details>
                    <summary>{item.question}<span class="plus">+</span></summary>
                    <div class="ans" set:html={item.answerHtml} />
                </details>
            ))}
        </div>
    </div>
</section>

<style>
    .faq {
        max-width: 880px;
        margin: 0 auto;
    }

    .faq details {
        border: 1px solid var(--hairline);
        background: rgba(10, 15, 30, 0.4);
        border-radius: 2px;
        transition:
            border-color 0.2s,
            background 0.2s;
    }

    .faq details + details {
        margin-top: 8px;
    }

    .faq details[open] {
        border-color: var(--hairline-strong);
        background: rgba(27, 41, 60, 0.55);
    }

    .faq summary {
        list-style: none;
        cursor: pointer;
        padding: 20px 24px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 16px;
        align-items: center;
        font-family: "Chakra Petch", sans-serif;
        font-weight: 600;
        font-size: 16px;
        color: var(--texto-principal);
        letter-spacing: 0.005em;
    }

    .faq summary::-webkit-details-marker {
        display: none;
    }

    .faq summary:hover {
        color: var(--nucleo-eletrico);
    }

    .faq summary .plus {
        width: 24px;
        height: 24px;
        border: 1px solid var(--hairline);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--nucleo-eletrico);
        transition: transform 0.25s;
        flex-shrink: 0;
    }

    .faq details[open] summary .plus {
        transform: rotate(45deg);
        background: rgba(0, 255, 255, 0.08);
    }

    .faq .ans {
        padding: 0 24px 22px;
        color: var(--texto-secundario);
        font-size: 14.5px;
        line-height: 1.65;
    }

    .faq .ans p {
        margin: 0 0 10px;
    }

    .faq .ans p:last-child {
        margin-bottom: 0;
    }
</style>

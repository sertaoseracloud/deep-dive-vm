---
// Card de um curso do hub. Estilos em src/styles/hub.css.
import type { Course } from "../../data/courses";

interface Props {
  course: Course;
}

const { course } = Astro.props;
---

<div class={`course-card ${course.status}`} data-status={course.status}>
  <div class="course-header">
    <h3 class="course-title">{course.title}</h3>
    {course.status === "coming-soon" && <span class="badge badge-coming-soon">EM BREVE</span>}
  </div>
  <ul class="chips" aria-label="Destaques">
    {course.exercises && <li class="chip chip-forte">{course.exercises} exercícios</li>}
    <li class="chip">Grátis</li>
    <li class="chip">Certificado</li>
  </ul>
  <p class="course-description">{course.description}</p>
  {course.status === "active" && (
    <div class="course-actions">
      {course.external ? (
        <a href={course.url} class="course-link" target="_blank" rel="noopener noreferrer">
          Acessar curso<span aria-hidden="true"> →</span><span class="sr-only"> {course.title} (abre em nova aba)</span>
        </a>
      ) : (
        <a href={course.url} class="course-link">
          Acessar curso<span aria-hidden="true"> →</span><span class="sr-only"> {course.title}</span>
        </a>
      )}
      {course.repo && (
        <a href={course.repo} class="link-texto" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
          </svg>
          Dar uma star no GitHub<span class="sr-only"> para o {course.title} (abre em nova aba)</span>
        </a>
      )}
    </div>
  )}
</div>
